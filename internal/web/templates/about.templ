package templates

import "github.com/stazelabs/vaquero/internal/legal"

// LicensesPage is vaquero's licence and notice, then every third-party
// component compiled or bundled into it, with its licence.
templ LicensesPage(license, notice string, components []legal.Component) {
	@Shell("Licences") {
		<h1 class={ h1Class }>Licences</h1>
		<section class="mt-6">
			<h2 class={ h2Class }>Vaquero</h2>
			<pre class="mt-2 whitespace-pre-wrap font-mono text-xs text-ink/80">{ notice }</pre>
			<details class="mt-3">
				<summary class="cursor-pointer text-sm text-accent hover:underline">Apache License 2.0</summary>
				<pre class="mt-2 max-h-96 overflow-auto whitespace-pre-wrap rounded-md bg-paper-alt p-3 font-mono text-xs text-ink/80">{ license }</pre>
			</details>
		</section>
		<section id="notices" class="mt-10">
			<h2 class={ h2Class }>Open source notices</h2>
			<p class="mt-1 text-sm text-muted">Vaquero includes these components. Each is used under the licence shown.</p>
			<ul class="mt-4 divide-y divide-line rounded-md border border-line">
				for _, c := range components {
					<li class="px-3 py-2">
						<details>
							<summary class="cursor-pointer text-sm">
								<span class="font-medium text-ink">{ c.Name }</span>
								if c.Version != "" {
									<span class="text-muted"> { c.Version }</span>
								}
							</summary>
							if c.URL != "" {
								<a href={ templ.SafeURL(c.URL) } class={ btnLink }>{ c.URL }</a>
							}
							<pre class="mt-2 max-h-80 overflow-auto whitespace-pre-wrap rounded-md bg-paper-alt p-3 font-mono text-xs text-ink/80">{ c.License }</pre>
						</details>
					</li>
				}
			</ul>
		</section>
	}
}
