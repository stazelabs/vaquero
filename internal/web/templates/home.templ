package templates

// HomePage is the placeholder front page until projects arrive.
templ HomePage() {
	@Shell("") {
		<h1 class={ h1Class }>Vaquero</h1>
		<p class="mt-2 text-lg text-accent">Vaquero herds the chaos.</p>
		<p class="mt-6 text-sm text-muted">Nothing to herd yet. Projects and tickets arrive in the next phase.</p>
	}
}
