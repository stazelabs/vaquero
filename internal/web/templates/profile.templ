package templates

// ProfileView is the profile page (VAQ-149): the owner as drawn, the name
// field's value and its refusal.
type ProfileView struct {
	Owner       ActorView
	DisplayName string
	Error       string
}

// ProfilePage is /profile: the owner's display name and avatar. It isn't
// under /admin: in hosted mode each person has their own.
templ ProfilePage(v ProfileView) {
	@Shell("Profile") {
		<div class="max-w-2xl">
			<div class="flex items-center gap-3">
				@Avatar(v.Owner, "md")
				<div class="min-w-0">
					<h1 class={ h1Class }>Profile</h1>
					<p class="text-sm text-muted">Your name and picture, shown beside your tickets, comments and history.</p>
				</div>
			</div>
			<section id="name" class="mt-10">
				<h2 class={ h2Class }>Name</h2>
				<form method="post" action="/profile" class="mt-3 space-y-4">
					@TextInput(InputProps{Name: "display_name", Label: "Display name", Value: v.DisplayName, Placeholder: "Owner", Autocomplete: "name", Error: v.Error})
					<p class="text-xs text-muted">Up to 80 characters. Leave it empty to show Owner. The assignee field takes either name.</p>
					<button type="submit" class={ btnPrimary }>Save profile</button>
				</form>
			</section>
			<section id="avatar" class="mt-10">
				<h2 class={ h2Class }>Avatar</h2>
				<p class="mt-1 text-sm text-muted">Without an image, your initials show on a coloured tile.</p>
				<form method="post" action="/profile/avatar" enctype="multipart/form-data" class="mt-3 space-y-3">
					<label for="f-avatar-file" class="block text-sm text-ink">Image</label>
					<input id="f-avatar-file" type="file" name="file" required accept="image/png,image/jpeg,image/webp" class="block w-full text-sm text-ink file:mr-3 file:rounded-md file:border file:border-line file:bg-paper-alt file:px-3 file:py-1.5 file:text-sm file:text-ink"/>
					<p class="text-xs text-muted">PNG, JPEG or WebP, up to 256 KB. Shown round, cropped to fit.</p>
					<button type="submit" class={ btnSecondary }>Upload avatar</button>
				</form>
				if v.Owner.Image {
					<form method="post" action="/profile/avatar/delete" class="mt-3" data-confirm="Remove your avatar? Your initials show again.">
						<button type="submit" class={ btnDanger }>Remove avatar</button>
					</form>
				}
			</section>
		</div>
	}
}
