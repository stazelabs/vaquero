package templates

// TextInput is the one single-line field: a label, then the input with id
// "f-" + Name (or ID), then its error message.
templ TextInput(p InputProps) {
	<div>
		if p.Label != "" {
			<label for={ p.id() } class={ labelClass }>{ p.Label }</label>
		}
		<input
			id={ p.id() }
			name={ p.Name }
			type={ p.inputType() }
			value={ p.Value }
			placeholder={ p.Placeholder }
			autocomplete={ p.autocomplete() }
			required?={ p.Required }
			if p.Error != "" {
				aria-invalid="true"
				aria-describedby={ p.id() + "-error" }
			}
			class={ fieldClass }
			{ p.attrs()... }
		/>
		@FieldError(p.id()+"-error", p.Error)
	</div>
}

// TextArea is TextInput for several lines, Rows tall. With Markdown, a
// small link to the Markdown article sits under it.
templ TextArea(p InputProps) {
	<div>
		if p.Label != "" {
			<label for={ p.id() } class={ labelClass }>{ p.Label }</label>
		}
		<textarea
			id={ p.id() }
			name={ p.Name }
			rows={ p.rows() }
			placeholder={ p.Placeholder }
			required?={ p.Required }
			if p.Error != "" {
				aria-invalid="true"
				aria-describedby={ p.id() + "-error" }
			}
			class={ inputClass }
			{ p.attrs()... }
		>{ p.Value }</textarea>
		@FieldError(p.id()+"-error", p.Error)
		if p.Markdown {
			@markdownHelp()
		}
	</div>
}

// markdownHelp is the small link under a box that takes Markdown. It opens
// the article in a new tab, so what is typed in the box stays.
templ markdownHelp() {
	<p class="mt-1 flex justify-end text-xs">
		<a href="/help/markdown" data-markdown-help target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-muted hover:text-accent">
			@IconClass("markdown", "h-3.5 w-3.5")
			Markdown
			<span class="sr-only">help, opens in a new tab</span>
		</a>
	</p>
}

// Select is a labelled drop-down with id "f-" + Name.
templ Select(p SelectProps) {
	<div>
		if p.Label != "" {
			<label for={ "f-" + p.Name } class={ labelClass }>{ p.Label }</label>
		}
		<select
			id={ "f-" + p.Name }
			name={ p.Name }
			if p.Error != "" {
				aria-invalid="true"
				aria-describedby={ "f-" + p.Name + "-error" }
			}
			class={ fieldClass }
		>
			for _, o := range p.Options {
				<option value={ o.Value } selected?={ o.Value == p.Selected }>{ o.Label }</option>
			}
		</select>
		@FieldError("f-"+p.Name+"-error", p.Error)
	</div>
}

// FieldError is a refused field's message, with the id its field's
// aria-describedby names; nothing when msg is empty.
templ FieldError(id, msg string) {
	if msg != "" {
		<p id={ id } class="mt-1 text-sm text-danger" role="alert">{ msg }</p>
	}
}

// emptyState is a muted glyph above a sentence, for a page with nothing in it.
templ emptyState(icon, text string) {
	<div class="mt-8 flex flex-col items-center gap-3 rounded-lg border border-dashed border-line px-6 py-10 text-center text-sm text-muted">
		@IconClass(icon, "h-8 w-8 shrink-0 opacity-70")
		<p>{ text }</p>
	</div>
}

// emptyStateLink is emptyState with a next step.
templ emptyStateLink(icon, text, href, label string) {
	<div class="mt-8 flex flex-col items-center gap-3 rounded-lg border border-dashed border-line px-6 py-10 text-center text-sm text-muted">
		@IconClass(icon, "h-8 w-8 shrink-0 opacity-70")
		<p>{ text }</p>
		<a href={ templ.SafeURL(href) } class={ btnLink }>{ label }</a>
	</div>
}
