package templates

import "strconv"

// InboxPage is /inbox (VAQ-172): what needs the owner, answered in place.
// #inbox follows changes; app.js's busy rule keeps a note being typed.
templ InboxPage(v InboxView) {
	@Shell("Inbox") {
		<h1 class={ h1Class }>Inbox</h1>
		<nav aria-label="Filter the inbox" class="mt-3 flex flex-wrap gap-1.5">
			for _, c := range v.Chips {
				<a href={ templ.SafeURL(c.Href) } class={ chipClass(c.On) } aria-current?={ c.On }>{ c.Label }</a>
			}
		</nav>
		@InboxSection(v)
	}
}

// InboxSection is the inbox's live part.
templ InboxSection(v InboxView) {
	<div id="inbox" data-inbox hx-get={ v.Self } hx-trigger="vq:change" hx-select="#inbox" hx-swap="outerHTML" hx-disinherit="*" data-live class="mt-4 space-y-6">
		if v.empty() {
			@emptyState("inbox", "Nothing needs you.")
		}
		if len(v.Decide) > 0 {
			<section data-inbox-group="decide" data-count={ countText(len(v.Decide)) } aria-labelledby="inbox-decide">
				@groupHead("inbox-decide", "Decide", len(v.Decide))
				<div class="mt-2 space-y-3">
					for _, c := range v.Decide {
						@DecisionCard(c)
					}
				</div>
			</section>
		}
		if len(v.Review) > 0 {
			<section data-inbox-group="review" data-count={ countText(len(v.Review)) } aria-labelledby="inbox-review">
				@groupHead("inbox-review", "Review", len(v.Review))
				<ul class="mt-2 border-t border-line">
					for _, r := range v.Review {
						<li data-card={ r.Key } data-review={ r.Key } class={ rowClass }>
							<a href={ templ.SafeURL("/t/" + r.Key) } data-ticket-link class="flex h-full min-w-0 flex-1 items-center gap-2 focus:outline-none" title={ r.Title }>
								<span class={ priorityMarkClass(r.Priority) }>
									if r.Priority > 0 {
										@IconClass(PriorityIcon(r.Priority), "h-3.5 w-3.5")
										<span class="sr-only">{ PriorityLabel(r.Priority) }</span>
									}
								</span>
								<span class="shrink-0 font-mono text-xs text-muted">{ r.Key }</span>
								<span class={ rowTitle }>{ r.Title }</span>
								<span class={ rowMeta }>
									if r.MovedBy != "" {
										<span class="truncate">{ r.MovedBy }</span>
									}
									<span>{ r.Age }</span>
								</span>
							</a>
						</li>
					}
				</ul>
			</section>
		}
		if len(v.Check) > 0 {
			<section data-inbox-group="check" data-count={ countText(len(v.Check)) } aria-labelledby="inbox-check">
				@groupHead("inbox-check", "Check", len(v.Check))
				<ul class="mt-2 border-t border-line">
					for _, l := range v.Check {
						<li data-lapse={ strconv.FormatInt(l.Seq, 10) } class={ rowClass }>
							<a href={ templ.SafeURL("/t/" + l.Key) } class="flex h-full min-w-0 flex-1 items-center gap-2 focus:outline-none" title={ l.Title }>
								<span class={ rowTitle }>{ l.Agent + "'s claim on " + l.Key + " lapsed " + l.Ago }</span>
							</a>
							<button type="button" data-dismiss hidden class="shrink-0 text-xs text-muted hover:text-accent">Dismiss</button>
						</li>
					}
				</ul>
			</section>
		}
		if len(v.Rulings) > 0 {
			<section data-inbox-group="rulings" data-count={ countText(len(v.Rulings)) } aria-labelledby="inbox-rulings">
				@groupHead("inbox-rulings", "Rulings agents made", len(v.Rulings))
				<ul class="mt-2 border-t border-line">
					for _, r := range v.Rulings {
						<li class="border-b border-line">
							<details data-ruling={ r.Card.ID } data-keep={ "ruling-" + r.Card.ID }>
								<summary class="flex h-row min-w-0 cursor-pointer items-center gap-2 px-1.5 text-sm hover:bg-paper/60">
									<span class={ rowTitle }>{ r.Question }</span>
									<span class={ rowMeta }><span class="truncate">{ r.Ruled }</span></span>
								</summary>
								<div class="pb-3">
									@DecisionCard(r.Card)
								</div>
							</details>
						</li>
					}
				</ul>
			</section>
		}
		if len(v.Answered) > 0 {
			<section data-inbox-group="answered" aria-label="Answered today">
				<details data-keep="answered">
					<summary class="cursor-pointer text-sm font-semibold text-ink hover:text-accent">Answered today ({ countText(len(v.Answered)) })</summary>
					<ul class="mt-2 border-t border-line">
						for _, a := range v.Answered {
							<li class="border-b border-line px-1.5 py-1.5 text-sm">
								<p class="min-w-0 truncate text-ink">{ a.Question }</p>
								<p class="text-xs text-muted">{ a.ProjectKey } · { a.Answer } · { a.How } · { a.Ago }</p>
							</li>
						}
					</ul>
				</details>
			</section>
		}
	</div>
}

templ groupHead(id, label string, n int) {
	<h2 id={ id } class="text-xs font-semibold uppercase tracking-wider text-muted">{ label } · <span data-group-count>{ countText(n) }</span></h2>
}

// DecisionCard is one decision answered in place: its head line, the
// question, the options as buttons (the recommended one first, marked),
// what an approval covers, the tickets it names, a note and Withdraw. Each
// button posts with htmx and the answer replaces the card: an empty one
// leaves the list, a refusal shows under the buttons. Without JavaScript
// the forms post and return to Back. A refused card carries data-hold:
// while it has the focus, live refreshes wait, so the refusal is read. app.js's keys: j and k move between
// cards, 1 to 9 choose an option, n opens the note, o opens the ticket.
templ DecisionCard(c DecisionCardView) {
	<article id={ "decision-" + c.ID } data-decision={ c.ID } data-card={ c.ID } data-card-focus tabindex="-1" data-hold?={ c.Error != "" } class="scroll-mt-12 rounded-sm border border-line bg-paper p-3 focus:outline-none focus:ring-2 focus:ring-accent">
		<p class="text-xs text-muted">{ kindLabel(c) } · { c.ProjectKey } · { c.AskedBy } · { c.Age }</p>
		<div class={ proseClass + " mt-1" }>
			@templ.Raw(string(c.Question))
		</div>
		if c.Answered != "" {
			<p class="mt-1 text-xs text-ink/80">{ c.Answered }</p>
		}
		if c.Covers != "" {
			<p data-covers class="mt-1 text-xs text-muted">{ c.Covers }</p>
		}
		if c.PlanKey != "" {
			<details data-show-plan data-keep={ "plan-" + c.ID } class="mt-1" hx-get={ "/t/" + c.PlanKey + "/plan" } hx-trigger="toggle once" hx-target="find [data-plan]" hx-swap="innerHTML">
				<summary class="cursor-pointer text-xs text-accent hover:underline">Show plan</summary>
				<div data-plan class="mt-2 rounded-sm border border-line bg-paper-alt p-3">
					<p class="text-xs text-muted">Loading the plan…</p>
				</div>
			</details>
		}
		if len(c.Tickets) > 0 {
			<p class="mt-1 flex flex-wrap gap-x-2 text-xs">
				for _, t := range c.Tickets {
					<a href={ templ.SafeURL("/t/" + t.Key) } data-ticket-link class="min-w-0 truncate text-accent hover:underline">
						<span class="font-mono">{ t.Key }</span> { t.Title }
					</a>
				}
			</p>
		}
		<form method="post" action={ templ.SafeURL(cardAnswerURL(c.ID)) } hx-post={ cardAnswerURL(c.ID) } hx-target={ "#decision-" + c.ID } hx-swap="outerHTML" class="mt-2">
			<input type="hidden" name="back" value={ c.Back }/>
			if c.Kind == "ruling" {
				<p class="mb-1 text-xs font-semibold text-ink/80">Overrule</p>
			}
			if len(c.Options) > 0 {
				<ul class="flex flex-wrap gap-2">
					for i, o := range c.Options {
						<li class="min-w-0 max-w-full">
							<button type="submit" name="option" value={ o.Label } data-option={ optionKey(i) } class={ optionClass(o.Recommended) }>
								{ o.Label }
								if o.Recommended {
									<span data-recommended class="rounded-sm border border-current px-1 text-xs font-normal">Recommended</span>
								}
							</button>
							if o.Tradeoff != "" {
								<p class="mt-0.5 max-w-xs text-xs text-muted">{ o.Tradeoff }</p>
							}
						</li>
					}
				</ul>
			} else {
				<div class="flex items-end gap-2">
					<textarea name="text" rows="2" aria-label="Answer" class={ inputClass }></textarea>
					<button type="submit" data-option="1" class={ optionClass(true) }>
						if c.Kind == "ruling" {
							Overrule
						} else {
							Answer
						}
					</button>
				</div>
			}
			if c.Error != "" {
				<p role="alert" data-card-error class="mt-2 text-xs text-danger">{ c.Error }</p>
			}
			<div class="mt-2 flex items-start gap-3">
				<details data-note open?={ c.Note != "" } class="min-w-0 flex-1">
					<summary class="cursor-pointer text-xs text-muted hover:text-accent">Add a note</summary>
					<textarea name="note" rows="2" aria-label="Note" class={ inputClass + " mt-1" }>{ c.Note }</textarea>
				</details>
				if c.Kind != "ruling" {
					// Its own form, below: forms don't nest.
					<button type="submit" form={ "withdraw-" + c.ID } class="shrink-0 text-xs text-muted hover:text-danger">Withdraw</button>
				}
			</div>
		</form>
		if c.Kind != "ruling" {
			<form id={ "withdraw-" + c.ID } method="post" action={ templ.SafeURL(cardWithdrawURL(c.ID)) } hx-post={ cardWithdrawURL(c.ID) } hx-target={ "#decision-" + c.ID } hx-swap="outerHTML" data-confirm={ withdrawQuestion(c) }>
				<input type="hidden" name="back" value={ c.Back }/>
			</form>
		}
	</article>
}

// PlanFragment is a ticket's plan as its page draws it, for a card's Show
// plan.
templ PlanFragment(p *PlanView) {
	if p == nil {
		<p class="text-xs text-muted">No plan.</p>
	} else {
		@planBody(*p)
	}
}
