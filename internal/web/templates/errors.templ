package templates

templ ErrorPage() {
	@Shell("Something went wrong") {
		<h1 class={ h1Class }>Something went wrong</h1>
		<p class="mt-3 text-sm text-ink/70">Vaquero hit an error. Try again in a moment.</p>
		<a href="/" class={ "mt-6 " + btnSecondary }>Go home</a>
	}
}

templ NotFoundPage() {
	@Shell("Page not found") {
		<h1 class={ h1Class }>Page not found</h1>
		<p class="mt-3 text-sm text-ink/70">The link may be old or mistyped.</p>
		<a href="/" class={ "mt-6 " + btnSecondary }>Go home</a>
	}
}
