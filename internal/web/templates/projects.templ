package templates

import "github.com/stazelabs/vaquero/internal/db/gen"

// ProjectForm is the new-project and edit-project form's values and errors.
type ProjectForm struct {
	Key, Name, Description string
	Errors                 map[string]string
}

// StatusRow is one status on the settings page.
type StatusRow struct {
	Status      gen.Status
	First, Last bool
}

// SubForm is one of the settings page's smaller forms, as typed: ID names
// the status or milestone a row form edits (empty for the add forms).
// Values and Errors are set only when that form was refused.
type SubForm struct {
	ID             string
	Values, Errors map[string]string
}

// Val is the typed value of field name, or def when the form wasn't refused.
func (f SubForm) Val(name, def string) string {
	if v, ok := f.Values[name]; ok {
		return v
	}
	return def
}

// SettingsView is the project settings page. NewStatus and NewMilestone
// are the add forms; EditStatus and EditMilestone the row form that was
// refused, if any.
type SettingsView struct {
	Project    gen.Project
	Form       ProjectForm
	Statuses   []StatusRow
	Milestones []gen.Milestone

	NewStatus, NewMilestone, EditStatus, EditMilestone SubForm
}

// row is the refused form f when it edits id, else an empty one.
func (f SubForm) row(id string) SubForm {
	if f.ID == id {
		return f
	}
	return SubForm{}
}

// ProjectListPage is the front page: every project, archived ones last.
templ ProjectListPage(rows []gen.ListProjectsRow) {
	@Shell("Projects") {
		<div class="flex items-center justify-between gap-4">
			<h1 class={ h1Class }>Projects</h1>
			<a href="/projects/new" class={ btnPrimary + " gap-1.5" }>
				@Icon("plus")
				New project
			</a>
		</div>
		if len(rows) == 0 {
			@emptyState("new-project", "No projects yet. Create one to start tracking tickets.")
		}
		<ul class="mt-6 divide-y divide-line">
			for _, p := range rows {
				if !p.ArchivedAt.Valid {
					@projectItem(p)
				}
			}
		</ul>
		if hasArchived(rows) {
			<details class="mt-8">
				<summary class="cursor-pointer text-sm text-muted">Archived</summary>
				<ul class="mt-2 divide-y divide-line">
					for _, p := range rows {
						if p.ArchivedAt.Valid {
							@projectItem(p)
						}
					}
				</ul>
			</details>
		}
	}
}

templ projectItem(p gen.ListProjectsRow) {
	<li class="flex items-center gap-4 py-3">
		<span class="text-muted">
			@Icon("project")
		</span>
		<a href={ templ.SafeURL("/p/" + p.Key) } class="font-mono text-sm font-semibold text-accent hover:underline">{ p.Key }</a>
		<a href={ templ.SafeURL("/p/" + p.Key) } class="flex-1 text-ink hover:text-accent">{ p.Name }</a>
		<span class="text-sm text-muted">{ countLabel(p.OpenCount, "open ticket", "open tickets") }</span>
	</li>
}

// ProjectNewPage is the new-project form.
templ ProjectNewPage(f ProjectForm) {
	@Shell("New project") {
		<h1 class={ h1Class }>New project</h1>
		<form method="post" action="/projects" class="mt-6 max-w-lg space-y-4">
			@TextInput(InputProps{Name: "key", Label: "Key", Value: f.Key, Required: true, Placeholder: "VAQ", Error: f.Errors["key"]})
			<p class="-mt-2 text-xs text-muted">2 to 10 capital letters or digits. Ticket keys start with it, like VAQ-12. It can't be changed later.</p>
			@TextInput(InputProps{Name: "name", Label: "Name", Value: f.Name, Required: true, Error: f.Errors["name"]})
			@TextArea(InputProps{Name: "description", Label: "Description", Value: f.Description, Rows: 4, Error: f.Errors["description"]})
			<div class="flex items-center gap-4">
				<button type="submit" class={ btnPrimary }>Create project</button>
				<a href="/" class={ btnLink }>Cancel</a>
			</div>
		</form>
	}
}

// ProjectSettingsPage edits a project, its statuses and milestones.
templ ProjectSettingsPage(v SettingsView) {
	@Shell(v.Project.Name + " settings") {
		<p class="font-mono text-sm text-muted"><a href={ templ.SafeURL("/p/" + v.Project.Key) } class="hover:text-accent">{ v.Project.Key }</a></p>
		@titleWithHelp("Settings", "projects-and-tickets", "About projects")
		<section class="mt-8">
			<h2 class={ h2Class }>Project</h2>
			<form method="post" action={ templ.SafeURL("/p/" + v.Project.Key) } class="mt-3 max-w-lg space-y-4">
				@TextInput(InputProps{Name: "name", Label: "Name", Value: v.Form.Name, Required: true, Error: v.Form.Errors["name"]})
				@TextArea(InputProps{Name: "description", Label: "Description", Value: v.Form.Description, Rows: 4, Error: v.Form.Errors["description"]})
				<button type="submit" class={ btnPrimary }>Save project</button>
			</form>
		</section>
		<section class="mt-10">
			<h2 class={ h2Class }>Key</h2>
			<p class="mt-1 max-w-lg text-sm text-muted">Tickets are numbered { v.Project.Key }-1, { v.Project.Key }-2 and so on. If you change the key, ticket links, branch names and commit messages that use { v.Project.Key } will stop working. Ticket numbers stay the same.</p>
			<form method="post" action={ templ.SafeURL("/p/" + v.Project.Key + "/key") } class="mt-3 flex max-w-lg items-end gap-3">
				<div class="flex-1">
					@TextInput(InputProps{Name: "key", ID: "f-new-key", Label: "New key", Value: v.Project.Key, Required: true})
				</div>
				<button type="submit" class={ btnSecondary }>Change key</button>
			</form>
		</section>
		<section class="mt-10">
			<h2 class={ h2IconClass }>
				@Icon("cat-in-progress")
				Statuses
			</h2>
			<p class="mt-1 text-sm text-muted">Tickets move through these in order. Each category keeps at least one status.</p>
			<ul class="mt-3 max-w-2xl divide-y divide-line rounded-md border border-line">
				for _, s := range v.Statuses {
					@statusItem(v.Project.Key, s, v.EditStatus.row(s.Status.ID))
				}
			</ul>
			<form method="post" action={ templ.SafeURL("/p/" + v.Project.Key + "/statuses") } class="mt-4 flex max-w-2xl flex-wrap items-end gap-3">
				<div class="flex-1">
					@TextInput(InputProps{Name: "name", ID: "f-status-name", Label: "New status", Value: v.NewStatus.Val("name", ""), Required: true, Error: v.NewStatus.Errors["name"]})
				</div>
				@Select(SelectProps{Name: "category", Label: "Category", Selected: v.NewStatus.Val("category", "todo"), Options: CategoryOptions(), Error: v.NewStatus.Errors["category"]})
				<button type="submit" class={ btnSecondary }>Add status</button>
			</form>
		</section>
		<section class="mt-10">
			<h2 class={ h2IconClass }>
				@Icon("milestone")
				Milestones
			</h2>
			if len(v.Milestones) == 0 {
				<p class="mt-2 text-sm text-muted">No milestones yet.</p>
			}
			<ul class="mt-3 max-w-2xl space-y-3">
				for _, m := range v.Milestones {
					@milestoneItem(v.Project.Key, m, v.EditMilestone.row(m.ID))
				}
			</ul>
			<form method="post" action={ templ.SafeURL("/p/" + v.Project.Key + "/milestones") } class="mt-4 flex max-w-2xl flex-wrap items-end gap-3">
				<div class="flex-1">
					@TextInput(InputProps{Name: "name", ID: "f-milestone-name", Label: "New milestone", Value: v.NewMilestone.Val("name", ""), Required: true, Error: v.NewMilestone.Errors["name"]})
				</div>
				@TextInput(InputProps{Name: "due_on", ID: "f-milestone-due", Label: "Due", Type: "date", Value: v.NewMilestone.Val("due_on", ""), Error: v.NewMilestone.Errors["due_on"]})
				<button type="submit" class={ btnSecondary }>Add milestone</button>
			</form>
		</section>
		<section class="mt-10">
			<h2 class={ h2IconClass }>
				@Icon("archive")
				Archive
			</h2>
			if v.Project.ArchivedAt.Valid {
				<p class="mt-2 text-sm text-muted">This project is archived: it is listed last and takes no new tickets.</p>
				<form method="post" action={ templ.SafeURL("/p/" + v.Project.Key + "/restore") } class="mt-3">
					<button type="submit" class={ btnSecondary }>Restore project</button>
				</form>
			} else {
				<p class="mt-2 text-sm text-muted">An archived project is listed last and takes no new tickets. Nothing is deleted.</p>
				<form method="post" action={ templ.SafeURL("/p/" + v.Project.Key + "/archive") } class="mt-3">
					<button type="submit" class={ btnDanger }>Archive project</button>
				</form>
			}
		</section>
		<section class="mt-10 rounded-lg border border-danger/40 p-4">
			<h2 class={ h2IconClass }>
				@Icon("delete")
				Delete project
			</h2>
			<p class="mt-1 max-w-lg text-sm text-ink/80">This removes { v.Project.Key } and everything in it: its tickets, comments, links, milestones, statuses and history. Links to its tickets from other projects are removed too. A backup of the whole database is saved first.</p>
			<form method="post" action={ templ.SafeURL("/p/" + v.Project.Key + "/delete") } class="mt-3 flex max-w-lg items-end gap-3">
				<div class="flex-1">
					@TextInput(InputProps{Name: "confirm", Label: "Type " + v.Project.Key + " to delete this project and everything in it", Required: true})
				</div>
				<button type="submit" class={ btnDanger }>Delete project</button>
			</form>
		</section>
	}
}

templ statusItem(key string, r StatusRow, edit SubForm) {
	<li class="flex flex-wrap items-center gap-3 px-3 py-2">
		<form method="post" action={ templ.SafeURL("/p/" + key + "/statuses/" + r.Status.ID + "/rename") } class="flex-1">
			<div class="flex items-center gap-2">
				<label for={ "s-" + r.Status.ID } class="sr-only">Name</label>
				<input
					id={ "s-" + r.Status.ID }
					name="name"
					value={ edit.Val("name", r.Status.Name) }
					if edit.Errors["name"] != "" {
						aria-invalid="true"
						aria-describedby={ "s-" + r.Status.ID + "-error" }
					}
					class={ inputClass + " max-w-48" }
				/>
				<button type="submit" class={ btnLink }>Rename</button>
			</div>
			@FieldError("s-"+r.Status.ID+"-error", edit.Errors["name"])
		</form>
		<span class="w-24 text-xs text-muted">{ CategoryLabel(r.Status.Category) }</span>
		<form method="post" action={ templ.SafeURL("/p/" + key + "/statuses/" + r.Status.ID + "/up") }>
			<button type="submit" class={ btnLink } disabled?={ r.First } aria-label={ "Move " + r.Status.Name + " up" }>Up</button>
		</form>
		<form method="post" action={ templ.SafeURL("/p/" + key + "/statuses/" + r.Status.ID + "/down") }>
			<button type="submit" class={ btnLink } disabled?={ r.Last } aria-label={ "Move " + r.Status.Name + " down" }>Down</button>
		</form>
		<form method="post" action={ templ.SafeURL("/p/" + key + "/statuses/" + r.Status.ID + "/delete") }>
			<button type="submit" class="text-sm text-danger hover:underline" aria-label={ "Delete " + r.Status.Name }>Delete</button>
		</form>
	</li>
}

templ milestoneItem(key string, m gen.Milestone, edit SubForm) {
	<li class={ panelClass }>
		<div class="flex flex-wrap items-baseline justify-between gap-2">
			<p class="font-medium text-ink">
				{ m.Name }
				if m.ClosedAt.Valid {
					<span class="ml-2 text-xs text-muted">Closed</span>
				}
			</p>
			<span class="text-sm text-muted">{ dueLabel(m) }</span>
		</div>
		<form method="post" action={ templ.SafeURL("/p/" + key + "/milestones/" + m.ID) } class="mt-3 flex flex-wrap items-end gap-3">
			<div class="flex-1">
				@TextInput(InputProps{Name: "name", ID: "m-name-" + m.ID, Label: "Name", Value: edit.Val("name", m.Name), Required: true, Error: edit.Errors["name"]})
			</div>
			@TextInput(InputProps{Name: "due_on", ID: "m-due-" + m.ID, Label: "Due", Type: "date", Value: edit.Val("due_on", m.DueOn.String), Error: edit.Errors["due_on"]})
			<button type="submit" class={ btnSecondary }>Save</button>
		</form>
		<form method="post" action={ templ.SafeURL("/p/" + key + "/milestones/" + m.ID + closeOrReopen(m)) } class="mt-2">
			<button type="submit" class={ btnLink }>
				if m.ClosedAt.Valid {
					Reopen milestone
				} else {
					Close milestone
				}
			</button>
		</form>
	</li>
}
