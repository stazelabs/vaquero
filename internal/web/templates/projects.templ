package templates

import (
	"github.com/stazelabs/vaquero/internal/board"
	"github.com/stazelabs/vaquero/internal/core"
	"github.com/stazelabs/vaquero/internal/db/gen"
)

// ProjectForm is the new-project and edit-project form's values and errors.
type ProjectForm struct {
	Key, Name, Description string
	Errors                 map[string]string
}

// StatusRow is one status on the settings page.
type StatusRow struct {
	Status      gen.Status
	First, Last bool
}

// SubForm is one of the settings page's smaller forms, as typed: ID names
// the status or milestone a row form edits (empty for the add forms).
// Values and Errors are set only when that form was refused.
type SubForm struct {
	ID             string
	Values, Errors map[string]string
}

// Val is the typed value of field name, or def when the form wasn't refused.
func (f SubForm) Val(name, def string) string {
	if v, ok := f.Values[name]; ok {
		return v
	}
	return def
}

// TagRow is one tag on the settings page: how many of the project's
// tickets carry it.
type TagRow struct {
	ID, Name string
	Tickets  int64
}

// SettingsView is the project settings page. NewStatus and NewMilestone
// are the add forms; EditStatus, EditMilestone and EditTag the row form
// that was refused, if any. MergeInto names the tag a refused rename would
// merge EditTag into, offered as a merge button.
type SettingsView struct {
	Project    gen.Project
	Form       ProjectForm
	Statuses   []StatusRow
	Milestones []gen.Milestone
	Tags       []TagRow
	MergeInto  string
	// TierMap is the effective tier map as indented JSON; TriageMissing
	// the triage statuses to offer (only with the workflow on).
	TierMap       string
	TriageMissing []string

	// Workflow is the workflow form, set only when it was refused.
	Workflow SubForm
	// HasIconImage is whether the project has a stored icon image, offered
	// again in the icon form.
	HasIconImage bool

	NewStatus, NewMilestone, EditStatus, EditMilestone, EditTag SubForm
}

// workflowOn is "on" when p uses the agent workflow, as its checkbox posts.
func workflowOn(p gen.Project) string {
	if p.Workflow == 1 {
		return "on"
	}
	return ""
}

// row is the refused form f when it edits id, else an empty one.
func (f SubForm) row(id string) SubForm {
	if f.ID == id {
		return f
	}
	return SubForm{}
}

// The projects page's views.
const (
	ViewCards = "cards"
	ViewList  = "list"
)

// ProjectsView is the projects page: the active projects with their stats,
// shown as View (ViewCards or ViewList), then the archived ones. Edit is a
// refused quick settings form, shown open on its project.
type ProjectsView struct {
	View     string
	Projects []ProjectCard
	Archived []gen.ListProjectsRow
	Edit     QuickEdit
}

// ProjectCard is one active project with its stats; LastChange is its
// newest event's time in words ("" when it has none).
type ProjectCard struct {
	Row        gen.ListProjectsRow
	Stats      board.ProjectStats
	LastChange string
}

// QuickEdit is a quick settings form as typed, when it was refused.
type QuickEdit struct {
	Key, Name, Description string
	Errors                 map[string]string
}

// quickForm is c's quick settings form: what was typed when it was
// refused, else the project's own values.
func (v ProjectsView) quickForm(c ProjectCard) QuickEdit {
	if v.Edit.Key == c.Row.Key {
		return v.Edit
	}
	return QuickEdit{Key: c.Row.Key, Name: c.Row.Name, Description: c.Row.Description}
}

// ProjectListPage is the front page: every active project as a card or a
// row with its stats and quick settings, then the archived ones.
templ ProjectListPage(v ProjectsView) {
	@Shell("Projects") {
		<div class="flex flex-wrap items-center justify-between gap-4">
			<h1 class={ h1Class }>Projects</h1>
			<div class="flex flex-wrap items-center gap-3">
				if len(v.Projects) > 0 {
					<nav aria-label="View" class="inline-flex rounded-md border border-line p-0.5">
						@projectsViewTab("/?view=cards", "cards", "Cards", v.View != ViewList)
						@projectsViewTab("/?view=list", "list", "List", v.View == ViewList)
					</nav>
				}
				<a href="/projects/new" class={ btnPrimary + " gap-1.5" }>
					@Icon("plus")
					New project
				</a>
			</div>
		</div>
		if len(v.Projects) == 0 && len(v.Archived) == 0 {
			@emptyState("new-project", "No projects yet. Create one to start tracking tickets.")
		}
		if len(v.Projects) > 0 {
			if v.View == ViewList {
				<ul data-projects-view="list" class="mt-6 divide-y divide-line border-y border-line">
					for _, c := range v.Projects {
						@projectRow(c, v.quickForm(c), v.Edit.Key == c.Row.Key)
					}
				</ul>
			} else {
				<ul data-projects-view="cards" class="mt-6 grid items-start gap-4 sm:grid-cols-2 lg:grid-cols-3">
					for _, c := range v.Projects {
						@projectCard(c, v.quickForm(c), v.Edit.Key == c.Row.Key)
					}
				</ul>
			}
		}
		if len(v.Archived) > 0 {
			<details class="mt-8">
				<summary class="cursor-pointer text-sm text-muted">Archived</summary>
				<ul class="mt-2 divide-y divide-line">
					for _, p := range v.Archived {
						@projectItem(p)
					}
				</ul>
			</details>
		}
	}
}

// projectsViewTab is one side of the cards and list switch.
templ projectsViewTab(href, icon, label string, current bool) {
	<a
		href={ templ.SafeURL(href) }
		if current {
			aria-current="page"
			class="inline-flex items-center gap-1.5 rounded px-2.5 py-1 text-sm font-medium bg-accent/15 text-ink"
		} else {
			class="inline-flex items-center gap-1.5 rounded px-2.5 py-1 text-sm font-medium text-muted hover:text-ink"
		}
	>
		@Icon(icon)
		{ label }
	</a>
}

// projectCard is one project as a card: icon, name and key, the
// description's first two lines, the counts, the open milestone and the
// last change, with quick settings behind "⋯". The description keeps two
// lines' room, so closed cards in a row line up; an open card grows alone.
templ projectCard(c ProjectCard, f QuickEdit, open bool) {
	<li data-project-card={ c.Row.Key } class="relative flex min-w-0 flex-col rounded-lg border border-line bg-paper-alt p-4">
		<div class="flex min-w-0 items-center gap-3 pr-8">
			@ProjectIcon(IconOfRow(c.Row), "md")
			<div class="min-w-0">
				<a href={ templ.SafeURL("/p/" + c.Row.Key) } class="block truncate font-medium text-ink hover:text-accent">{ c.Row.Name }</a>
				<p class="font-mono text-xs text-muted">{ c.Row.Key }</p>
			</div>
		</div>
		@projectDescription(c.Row.Description, "mt-3 line-clamp-2 min-h-10")
		<div class="pt-4">
			@projectCounts(c.Stats)
			<div class="mt-3">
				@projectMilestone(c.Stats.Milestone, true)
			</div>
			@projectLastChange(c.LastChange, "mt-2")
		</div>
		@quickSettings(c, f, open)
	</li>
}

// projectRow is one project as a list row: the card's content on one
// line where it fits, the description cut at one line.
templ projectRow(c ProjectCard, f QuickEdit, open bool) {
	<li data-project-row={ c.Row.Key } class="relative flex min-w-0 flex-wrap items-center gap-x-4 gap-y-1 py-3 pr-10">
		<div class="flex min-w-0 items-center gap-3 sm:w-64">
			@ProjectIcon(IconOfRow(c.Row), "sm")
			<a href={ templ.SafeURL("/p/" + c.Row.Key) } class="shrink-0 font-mono text-sm font-semibold text-accent hover:underline">{ c.Row.Key }</a>
			<a href={ templ.SafeURL("/p/" + c.Row.Key) } class="truncate text-ink hover:text-accent">{ c.Row.Name }</a>
		</div>
		@projectDescription(c.Row.Description, "line-clamp-1 basis-full md:basis-0 md:flex-1")
		@projectCounts(c.Stats)
		<div class="w-full sm:w-auto">
			@projectMilestone(c.Stats.Milestone, false)
		</div>
		@projectLastChange(c.LastChange, "")
		@quickSettings(c, f, open)
	</li>
}

templ projectDescription(text, class string) {
	if text != "" {
		<p data-description class={ "min-w-0 text-sm text-ink/80 " + class }>{ text }</p>
	} else {
		<p data-description class={ "min-w-0 text-sm text-muted " + class }>No description.</p>
	}
}

// projectCounts is a project's ready, in review and open counts.
templ projectCounts(s board.ProjectStats) {
	<p class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-ink/80">
		<span class="inline-flex items-center gap-1.5" title="Ready to start">
			@IconClass("ready", "h-4 w-4 shrink-0 text-accent")
			{ countLabel(int64(s.Ready), "ready", "ready") }
		</span>
		<span class="inline-flex items-center gap-1.5">
			@IconClass("cat-in-review", "h-4 w-4 shrink-0 text-muted")
			{ countLabel(int64(s.InReview), "in review", "in review") }
		</span>
		<span class="inline-flex items-center gap-1.5">
			@IconClass("cat-todo", "h-4 w-4 shrink-0 text-muted")
			{ countLabel(int64(s.Open), "open", "open") }
		</span>
	</p>
}

// projectMilestone is the open milestone's name and progress, with its bar
// when bar is set, or "No open milestone".
templ projectMilestone(m *board.MilestoneProgress, bar bool) {
	if m == nil {
		<p class="inline-flex items-center gap-1.5 text-sm text-muted">
			@Icon("milestone")
			No open milestone
		</p>
	} else {
		<div class="min-w-0 text-sm">
			<p class="flex min-w-0 items-center gap-1.5">
				<span class="shrink-0 text-muted">
					@Icon("milestone")
				</span>
				<span class="truncate text-ink">{ m.Name }</span>
				<span class="shrink-0 text-muted">{ itoa(m.Done) } of { itoa(m.Total) } done</span>
			</p>
			if bar {
				<progress value={ itoa(m.Done) } max={ itoa(maxOne(m.Total)) } class="progress-vq mt-1.5 block h-1.5 w-full">{ itoa(m.Done) } of { itoa(m.Total) }</progress>
			}
		</div>
	}
}

templ projectLastChange(ago, class string) {
	if ago != "" {
		<p class={ "inline-flex items-center gap-1.5 text-xs text-muted " + class } title="Last change">
			@Icon("history")
			{ ago }
		</p>
	}
}

// quickSettings is a project's "⋯" panel: its name and description, and
// its icon, each posting to the settings handlers with ?return=/ so they
// come back here. The summary sits in the item's top right corner; the
// panel opens in place below the item's content. The icon form (about 40
// glyphs) loads from /p/{key}/icon/choices the first time its part opens,
// except in a panel shown open after a refusal, which has it inline.
templ quickSettings(c ProjectCard, f QuickEdit, open bool) {
	<details data-quick-settings={ c.Row.Key } class="group w-full" open?={ open }>
		<summary class="absolute right-2 top-2 flex size-8 cursor-pointer list-none items-center justify-center rounded-md text-muted hover:bg-paper hover:text-ink group-open:bg-paper group-open:text-ink [&::-webkit-details-marker]:hidden" aria-label={ "Quick settings for " + c.Row.Name } title="Quick settings">
			@Icon("more")
		</summary>
		<div class="mt-3 space-y-5 border-t border-line pt-3">
			<form method="post" action={ templ.SafeURL("/p/" + c.Row.Key + "?return=/") } class="space-y-3">
				@TextInput(InputProps{Name: "name", ID: "q-name-" + c.Row.Key, Label: "Name", Value: f.Name, Required: true, Error: f.Errors["name"]})
				@TextArea(InputProps{Name: "description", ID: "q-desc-" + c.Row.Key, Label: "Description", Value: f.Description, Rows: 3, Error: f.Errors["description"]})
				<div class="flex flex-wrap items-center justify-between gap-3">
					<button type="submit" class={ btnPrimary }>Save project</button>
					<a href={ templ.SafeURL("/p/" + c.Row.Key + "/settings") } class={ btnLink }>All settings →</a>
				</div>
			</form>
			<details
				data-quick-icon
				class="group/icon"
				open?={ open }
				if !open {
					hx-get={ "/p/" + c.Row.Key + "/icon/choices" }
					hx-trigger="toggle once"
					hx-target="find [data-quick-icon-choices]"
				}
			>
				<summary class="inline-flex cursor-pointer list-none items-center gap-1.5 text-sm font-medium text-ink hover:text-accent [&::-webkit-details-marker]:hidden">
					@ProjectIcon(IconOfRow(c.Row), "sm")
					Icon
					@IconClass("expand", "h-4 w-4 shrink-0 text-muted transition-transform group-open/icon:rotate-180")
				</summary>
				<div data-quick-icon-choices class="mt-2">
					if open {
						@QuickIconChoices(IconOfRow(c.Row), c.Row.HasImage)
					} else {
						<p class="text-sm text-muted">Loading the icons…</p>
					}
				</div>
			</details>
		</div>
	</details>
}

// QuickIconChoices is the quick settings icon form, also served alone by
// /p/{key}/icon/choices: the monogram, a glyph, the stored image when
// there is one (hasImage), or a new image (a chosen file wins).
templ QuickIconChoices(p ProjectIconView, hasImage bool) {
	<form method="post" action={ templ.SafeURL("/p/" + p.Key + "/icon?return=/") } enctype="multipart/form-data" class="space-y-3">
		<fieldset>
			<legend class="sr-only">Icon</legend>
			<div class="grid grid-cols-[repeat(auto-fill,minmax(2.5rem,1fr))] gap-1.5">
				@iconChoice("monogram", "Monogram "+core.Monogram(p.Name, p.Key), p.Kind == core.IconKindMonogram) {
					@ProjectIcon(ProjectIconView{ID: p.ID, Key: p.Key, Name: p.Name, Kind: core.IconKindMonogram}, "md")
				}
				if hasImage {
					@iconChoice("image", "Uploaded image", p.Kind == core.IconKindImage) {
						@ProjectIcon(ProjectIconView{ID: p.ID, Key: p.Key, Kind: core.IconKindImage}, "md")
					}
				}
				for _, g := range core.ProjectGlyphs {
					@iconChoice("glyph:"+g, g, p.Kind == core.IconKindGlyph && p.Glyph == g) {
						@ProjectIcon(ProjectIconView{ID: p.ID, Key: p.Key, Kind: core.IconKindGlyph, Glyph: g}, "md")
					}
				}
			</div>
		</fieldset>
		<div>
			<label for={ "q-icon-" + p.Key } class="block text-sm text-ink">Upload image</label>
			<input id={ "q-icon-" + p.Key } type="file" name="file" accept="image/png,image/jpeg,image/webp" class="mt-1 block w-full min-w-0 text-sm text-ink file:mr-3 file:rounded-md file:border file:border-line file:bg-paper file:px-3 file:py-1.5 file:text-sm file:text-ink"/>
			<p class="mt-1 text-xs text-muted">PNG, JPEG or WebP, up to 256 KB.</p>
		</div>
		<button type="submit" class={ btnSecondary }>Save icon</button>
	</form>
}

// projectItem is an archived project's row.
templ projectItem(p gen.ListProjectsRow) {
	<li class="flex items-center gap-4 py-3">
		@ProjectIcon(IconOfRow(p), "sm")
		<a href={ templ.SafeURL("/p/" + p.Key) } class="font-mono text-sm font-semibold text-accent hover:underline">{ p.Key }</a>
		<a href={ templ.SafeURL("/p/" + p.Key) } class="flex-1 text-ink hover:text-accent">{ p.Name }</a>
		<span class="text-sm text-muted">{ countLabel(p.OpenCount, "open ticket", "open tickets") }</span>
	</li>
}

// ProjectNewPage is the new-project form.
templ ProjectNewPage(f ProjectForm) {
	@Shell("New project") {
		<h1 class={ h1Class }>New project</h1>
		<form method="post" action="/projects" class="mt-6 max-w-lg space-y-4">
			@TextInput(InputProps{Name: "key", Label: "Key", Value: f.Key, Required: true, Placeholder: "VAQ", Error: f.Errors["key"]})
			<p class="-mt-2 text-xs text-muted">2 to 10 capital letters or digits. Ticket keys start with it, like VAQ-12. It can't be changed later.</p>
			@TextInput(InputProps{Name: "name", Label: "Name", Value: f.Name, Required: true, Error: f.Errors["name"]})
			@TextArea(InputProps{Name: "description", Label: "Description", Value: f.Description, Rows: 4, Error: f.Errors["description"]})
			<div class="flex items-center gap-4">
				<button type="submit" class={ btnPrimary }>Create project</button>
				<a href="/" class={ btnLink }>Cancel</a>
			</div>
		</form>
	}
}

// ProjectSettingsPage edits a project, its statuses and milestones.
templ ProjectSettingsPage(v SettingsView) {
	@Shell(v.Project.Name + " settings") {
		<p class="flex items-center gap-2 font-mono text-sm text-muted">
			@ProjectIcon(IconOf(v.Project), "sm")
			<a href={ templ.SafeURL("/p/" + v.Project.Key) } class="hover:text-accent">{ v.Project.Key }</a>
		</p>
		@titleWithHelp("Settings", "projects-and-tickets", "About projects")
		<section class="mt-8">
			<h2 class={ h2Class }>Project</h2>
			<form method="post" action={ templ.SafeURL("/p/" + v.Project.Key) } class="mt-3 max-w-lg space-y-4">
				@TextInput(InputProps{Name: "name", Label: "Name", Value: v.Form.Name, Required: true, Error: v.Form.Errors["name"]})
				@TextArea(InputProps{Name: "description", Label: "Description", Value: v.Form.Description, Rows: 4, Error: v.Form.Errors["description"]})
				<button type="submit" class={ btnPrimary }>Save project</button>
			</form>
		</section>
		<section class="mt-10">
			<h2 class={ h2Class }>Key</h2>
			<p class="mt-1 max-w-lg text-sm text-muted">Tickets are numbered { v.Project.Key }-1, { v.Project.Key }-2 and so on. If you change the key, ticket links, branch names and commit messages that use { v.Project.Key } will stop working. Ticket numbers stay the same.</p>
			<form method="post" action={ templ.SafeURL("/p/" + v.Project.Key + "/key") } class="mt-3 flex max-w-lg items-end gap-3">
				<div class="flex-1">
					@TextInput(InputProps{Name: "key", ID: "f-new-key", Label: "New key", Value: v.Project.Key, Required: true})
				</div>
				<button type="submit" class={ btnSecondary }>Change key</button>
			</form>
		</section>
		@iconSection(v)
		@workflowSection(v)
		<section class="mt-10">
			<h2 class={ h2IconClass }>
				@Icon("cat-in-progress")
				Statuses
			</h2>
			<p class="mt-1 text-sm text-muted">Tickets move through these in order. Each category keeps at least one status.</p>
			<ul class="mt-3 max-w-2xl divide-y divide-line rounded-md border border-line">
				for _, s := range v.Statuses {
					@statusItem(v.Project.Key, s, v.EditStatus.row(s.Status.ID))
				}
			</ul>
			<form method="post" action={ templ.SafeURL("/p/" + v.Project.Key + "/statuses") } class="mt-4 flex max-w-2xl flex-wrap items-end gap-3">
				<div class="flex-1">
					@TextInput(InputProps{Name: "name", ID: "f-status-name", Label: "New status", Value: v.NewStatus.Val("name", ""), Required: true, Error: v.NewStatus.Errors["name"]})
				</div>
				@Select(SelectProps{Name: "category", Label: "Category", Selected: v.NewStatus.Val("category", "todo"), Options: CategoryOptions(), Error: v.NewStatus.Errors["category"]})
				<button type="submit" class={ btnSecondary }>Add status</button>
			</form>
		</section>
		<section class="mt-10">
			<h2 class={ h2IconClass }>
				@Icon("milestone")
				Milestones
			</h2>
			if len(v.Milestones) == 0 {
				<p class="mt-2 text-sm text-muted">No milestones yet.</p>
			}
			<ul class="mt-3 max-w-2xl space-y-3">
				for _, m := range v.Milestones {
					@milestoneItem(v.Project.Key, m, v.EditMilestone.row(m.ID))
				}
			</ul>
			<form method="post" action={ templ.SafeURL("/p/" + v.Project.Key + "/milestones") } class="mt-4 flex max-w-2xl flex-wrap items-end gap-3">
				<div class="flex-1">
					@TextInput(InputProps{Name: "name", ID: "f-milestone-name", Label: "New milestone", Value: v.NewMilestone.Val("name", ""), Required: true, Error: v.NewMilestone.Errors["name"]})
				</div>
				@TextInput(InputProps{Name: "due_on", ID: "f-milestone-due", Label: "Due", Type: "date", Value: v.NewMilestone.Val("due_on", ""), Error: v.NewMilestone.Errors["due_on"]})
				<button type="submit" class={ btnSecondary }>Add milestone</button>
			</form>
		</section>
		<section id="tags" class="mt-10">
			<h2 class={ h2IconClass }>
				@Icon("tag")
				Tags
			</h2>
			if len(v.Tags) == 0 {
				<p class="mt-2 text-sm text-muted">No tags yet. Tags are added on tickets.</p>
			} else {
				<p class="mt-1 max-w-2xl text-sm text-muted">Renaming a tag here changes it on this project's tickets only. Rename it to a name the project already uses to merge the two.</p>
				<ul class="mt-3 max-w-2xl divide-y divide-line rounded-md border border-line">
					for _, t := range v.Tags {
						@tagItem(v.Project.Key, t, v.EditTag.row(t.ID), v.MergeInto)
					}
				</ul>
			}
		</section>
		<section class="mt-10">
			<h2 class={ h2IconClass }>
				@Icon("archive")
				Archive
			</h2>
			if v.Project.ArchivedAt.Valid {
				<p class="mt-2 text-sm text-muted">This project is archived: it is listed last and takes no new tickets.</p>
				<form method="post" action={ templ.SafeURL("/p/" + v.Project.Key + "/restore") } class="mt-3">
					<button type="submit" class={ btnSecondary }>Restore project</button>
				</form>
			} else {
				<p class="mt-2 text-sm text-muted">An archived project is listed last and takes no new tickets. Nothing is deleted.</p>
				<form method="post" action={ templ.SafeURL("/p/" + v.Project.Key + "/archive") } class="mt-3" data-confirm={ "Archive " + v.Project.Key + "? It is listed last and takes no new tickets until you restore it." }>
					<button type="submit" class={ btnDanger }>Archive project</button>
				</form>
			}
		</section>
		<section class="mt-10 rounded-lg border border-danger/40 p-4">
			<h2 class={ h2IconClass }>
				@Icon("delete")
				Delete project
			</h2>
			<p class="mt-1 max-w-lg text-sm text-ink/80">This removes { v.Project.Key } and everything in it: its tickets, comments, links, milestones, statuses and history. Links to its tickets from other projects are removed too. A backup of the whole database is saved first.</p>
			<form method="post" action={ templ.SafeURL("/p/" + v.Project.Key + "/delete") } class="mt-3 flex max-w-lg items-end gap-3">
				<div class="flex-1">
					@TextInput(InputProps{Name: "confirm", Label: "Type " + v.Project.Key + " to delete this project and everything in it", Required: true})
				</div>
				<button type="submit" class={ btnDanger }>Delete project</button>
			</form>
		</section>
	}
}

// workflowSection is the agent workflow switch and the tier map, and
// with the workflow on, the offer of any missing triage statuses.
templ workflowSection(v SettingsView) {
	<section id="workflow" class="mt-10">
		<h2 class={ h2IconClass }>
			@Icon("agent")
			Workflow
		</h2>
		<p class="mt-1 max-w-2xl text-sm text-muted">
			Tickets carry an execution tier when the agent workflow is on; the tier map names the model each tier uses in each harness.
			@helpLink("agent-workflow", "About the agent workflow")
		</p>
		<form method="post" action={ templ.SafeURL("/p/" + v.Project.Key + "/workflow") } class="mt-3 max-w-2xl space-y-4">
			<label class="flex items-center gap-2 text-sm text-ink">
				<input type="checkbox" name="workflow" value="on" checked?={ v.Workflow.Val("workflow", workflowOn(v.Project)) == "on" } class="size-4 accent-accent"/>
				Use the agent workflow in this project
			</label>
			@TextArea(InputProps{Name: "tier_map", ID: "f-tier-map", Label: "Tier map", Value: v.Workflow.Val("tier_map", v.TierMap), Rows: 14, Error: v.Workflow.Errors["tier_map"], Attrs: templ.Attributes{"spellcheck": "false"}})
			<p class="-mt-2 text-xs text-muted">JSON: each harness names a model for any of design, light, standard and heavy. Empty it to go back to the defaults.</p>
			<button type="submit" class={ btnSecondary }>Save workflow</button>
		</form>
		if len(v.TriageMissing) > 0 {
			<div class="mt-4 max-w-2xl rounded-md border border-line bg-paper-alt px-3 py-2 text-sm text-ink">
				<p>The workflow parks tickets in two backlog statuses, Needs decision and Needs design. Missing here: { joinAnd(v.TriageMissing) }.</p>
				<form method="post" action={ templ.SafeURL("/p/" + v.Project.Key + "/triage-statuses") } class="mt-2">
					<button type="submit" class={ btnSecondary }>Add the triage statuses</button>
				</form>
			</div>
		}
	</section>
}

templ statusItem(key string, r StatusRow, edit SubForm) {
	<li class="flex flex-wrap items-center gap-3 px-3 py-2">
		<form method="post" action={ templ.SafeURL("/p/" + key + "/statuses/" + r.Status.ID + "/rename") } class="flex-1">
			<div class="flex items-center gap-2">
				<label for={ "s-" + r.Status.ID } class="sr-only">Name</label>
				<input
					id={ "s-" + r.Status.ID }
					name="name"
					value={ edit.Val("name", r.Status.Name) }
					if edit.Errors["name"] != "" {
						aria-invalid="true"
						aria-describedby={ "s-" + r.Status.ID + "-error" }
					}
					class={ inputClass + " max-w-48" }
				/>
				<button type="submit" class={ btnLink }>Rename</button>
			</div>
			@FieldError("s-"+r.Status.ID+"-error", edit.Errors["name"])
		</form>
		<span class="w-24 text-xs text-muted">{ CategoryLabel(r.Status.Category) }</span>
		<form method="post" action={ templ.SafeURL("/p/" + key + "/statuses/" + r.Status.ID + "/up") }>
			<button type="submit" class={ btnLink } disabled?={ r.First } aria-label={ "Move " + r.Status.Name + " up" }>Up</button>
		</form>
		<form method="post" action={ templ.SafeURL("/p/" + key + "/statuses/" + r.Status.ID + "/down") }>
			<button type="submit" class={ btnLink } disabled?={ r.Last } aria-label={ "Move " + r.Status.Name + " down" }>Down</button>
		</form>
		<form method="post" action={ templ.SafeURL("/p/" + key + "/statuses/" + r.Status.ID + "/delete") } data-confirm={ "Delete the status " + r.Status.Name + "?" }>
			<button type="submit" class="text-sm text-danger hover:underline" aria-label={ "Delete " + r.Status.Name }>Delete</button>
		</form>
	</li>
}

templ milestoneItem(key string, m gen.Milestone, edit SubForm) {
	<li class={ panelClass }>
		<div class="flex flex-wrap items-baseline justify-between gap-2">
			<p class="font-medium text-ink">
				{ m.Name }
				if m.ClosedAt.Valid {
					<span class="ml-2 text-xs text-muted">Closed</span>
				}
			</p>
			<span class="text-sm text-muted">{ dueLabel(m) }</span>
		</div>
		<form method="post" action={ templ.SafeURL("/p/" + key + "/milestones/" + m.ID) } class="mt-3 flex flex-wrap items-end gap-3">
			<div class="flex-1">
				@TextInput(InputProps{Name: "name", ID: "m-name-" + m.ID, Label: "Name", Value: edit.Val("name", m.Name), Required: true, Error: edit.Errors["name"]})
			</div>
			@TextInput(InputProps{Name: "due_on", ID: "m-due-" + m.ID, Label: "Due", Type: "date", Value: edit.Val("due_on", m.DueOn.String), Error: edit.Errors["due_on"]})
			<div class="w-full">
				@TextArea(InputProps{Name: "description", ID: "m-desc-" + m.ID, Label: "Description", Value: edit.Val("description", m.Description), Rows: 3, Error: edit.Errors["description"]})
			</div>
			<button type="submit" class={ btnSecondary }>Save</button>
		</form>
		<form method="post" action={ templ.SafeURL("/p/" + key + "/milestones/" + m.ID + closeOrReopen(m)) } class="mt-2">
			<button type="submit" class={ btnLink }>
				if m.ClosedAt.Valid {
					Reopen milestone
				} else {
					Close milestone
				}
			</button>
		</form>
	</li>
}

// tagItem is one tag's row: rename, its ticket count and delete. When a
// rename was refused because the name is taken, merge offers to fold this
// tag into that one.
templ tagItem(key string, t TagRow, edit SubForm, mergeInto string) {
	<li class="flex flex-wrap items-center gap-3 px-3 py-2">
		<form method="post" action={ templ.SafeURL("/p/" + key + "/tags/" + t.ID + "/rename") } class="flex-1">
			<div class="flex items-center gap-2">
				<label for={ "tag-" + t.ID } class="sr-only">Name</label>
				<input
					id={ "tag-" + t.ID }
					name="name"
					value={ edit.Val("name", t.Name) }
					if edit.Errors["name"] != "" {
						aria-invalid="true"
						aria-describedby={ "tag-" + t.ID + "-error" }
					}
					class={ inputClass + " max-w-48" }
				/>
				<button type="submit" class={ btnLink }>Rename</button>
			</div>
			@FieldError("tag-"+t.ID+"-error", edit.Errors["name"])
		</form>
		if edit.ID != "" && mergeInto != "" {
			<form method="post" action={ templ.SafeURL("/p/" + key + "/tags/" + t.ID + "/rename") } data-confirm={ mergeQuestion(key, t, mergeInto) }>
				<input type="hidden" name="name" value={ edit.Val("name", mergeInto) }/>
				<input type="hidden" name="merge" value="1"/>
				<button type="submit" class={ btnSecondary + " gap-1.5" }>
					@Icon("merge")
					Merge into { mergeInto }
				</button>
			</form>
		}
		<span class="w-24 text-xs text-muted">{ countLabel(t.Tickets, "ticket", "tickets") }</span>
		<form method="post" action={ templ.SafeURL("/p/" + key + "/tags/" + t.ID + "/delete") } data-confirm={ "Delete the tag " + t.Name + "? It comes off " + countLabel(t.Tickets, "ticket", "tickets") + " in " + key + "." }>
			<button type="submit" class="text-sm text-danger hover:underline" aria-label={ "Delete tag " + t.Name }>Delete</button>
		</form>
	</li>
}
