package templates

import (
	"time"

	"github.com/stazelabs/vaquero/internal/db/gen"
)

// AdminPages are the admin section's pages, in its side list.
var AdminPages = [][2]string{{"/admin", "Overview"}, {"/admin/backups", "Backups"}, {"/admin/tokens", "API tokens"}, {"/admin/mcp", "MCP activity"}}

// adminIcons are the side list's glyphs.
var adminIcons = map[string]string{"/admin": "overview", "/admin/backups": "backups", "/admin/tokens": "token", "/admin/mcp": "agent"}

// AdminShell is an admin page: the side list, then the page.
templ AdminShell(title, current string) {
	@Shell(title) {
		<div class="flex flex-col gap-8 md:flex-row">
			<nav aria-label="Admin" class="shrink-0 md:w-48">
				<p class={ h2Class }>Admin</p>
				<ul class="mt-2 space-y-1">
					for _, p := range AdminPages {
						<li>
							<a
								href={ templ.SafeURL(p[0]) }
								if p[0] == current {
									aria-current="page"
								}
								class={ adminNavClass(p[0] == current) }
							>
								@Icon(adminIcons[p[0]])
								{ p[1] }
							</a>
						</li>
					}
				</ul>
			</nav>
			<div class="min-w-0 flex-1">
				{ children... }
			</div>
		</div>
	}
}

// AdminInfo is the admin home's facts. Uptime and Since are empty when the
// start time isn't known; Brew is whether brew services runs the server.
type AdminInfo struct {
	Version, DataDir, DBSize, WALSize string
	Uptime, Since                     string
	Schema                            int64
	Brew                              bool
	Storage                           StorageInfo
}

// StorageInfo is the read-only Storage section (VAQ-148): the backend, where
// it keeps the bytes ("" for sqlite: in the database), the attachments,
// each storage setting already redacted with its source, and the settings
// file.
type StorageInfo struct {
	Backend, Location string
	Count             int64
	Size              string
	Settings          []SettingRow
	EnvFile           string
	EnvFileExists     bool
}

// SettingRow is one setting: its name, its value as it may be shown
// (config.Redact) and where it came from (config.Source*).
type SettingRow struct{ Key, Value, Source string }

// sourceLabel words a setting's source.
func sourceLabel(s string) string {
	switch s {
	case "file":
		return "vaquero.env"
	case "environment":
		return "environment"
	}
	return "default"
}

func attachmentCount(n int64) string {
	if n == 1 {
		return "1 attachment"
	}
	return itoa(n) + " attachments"
}

templ AdminHomePage(i AdminInfo) {
	@AdminShell("Admin", "/admin") {
		<h1 class={ h1Class }>Overview</h1>
		<section id="system" class="mt-6">
			<h2 class={ h2Class }>System</h2>
			<dl class="mt-3 grid max-w-xl grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-sm">
				<dt class="text-muted">Version</dt>
				<dd class="break-all text-ink">{ i.Version }</dd>
				if i.Uptime != "" {
					<dt class="text-muted">Uptime</dt>
					<dd class="text-ink">{ i.Uptime } <span class="text-muted">· since { i.Since }</span></dd>
				}
				<dt class="text-muted">Service</dt>
				<dd class="text-ink">
					if i.Brew {
						Running under brew services
					} else {
						Not a brew service
					}
				</dd>
				<dt class="text-muted">Data directory</dt>
				<dd class="break-all font-mono text-xs text-ink">{ i.DataDir }</dd>
				<dt class="text-muted">Database size</dt>
				<dd class="text-ink">{ i.DBSize }</dd>
				<dt class="text-muted">Write-ahead log (WAL)</dt>
				<dd class="text-ink">{ i.WALSize }</dd>
				<dt class="text-muted">Schema version</dt>
				<dd class="text-ink">{ itoa(i.Schema) }</dd>
			</dl>
		</section>
		@storageSection(i.Storage, i.Brew)
		<ul class="mt-8 space-y-2 text-sm">
			<li><a href="/admin/backups" class={ btnLink }>Backups</a> <span class="text-muted">· snapshots of the database, taken and deleted here</span></li>
			<li><a href="/admin/tokens" class={ btnLink }>API tokens</a> <span class="text-muted">· for the CLI, scripts and agents</span></li>
			<li><a href="/admin/mcp" class={ btnLink }>MCP activity</a> <span class="text-muted">· every tool call agents made over MCP</span></li>
		</ul>
	}
}

templ storageSection(s StorageInfo, brew bool) {
	<section id="storage" class="mt-8 max-w-xl">
		<h2 class={ h2Class }>Storage</h2>
		<dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-sm">
			<dt class="text-muted">Attachments</dt>
			<dd class="text-ink">
				if s.Count == 0 {
					No attachments yet.
				} else {
					{ attachmentCount(s.Count) }, { s.Size }
				}
			</dd>
			<dt class="text-muted">Kept in</dt>
			<dd class="break-all text-ink">
				if s.Backend == "sqlite" {
					In the database (vaquero.db)
				} else if s.Backend == "dir" {
					A directory: <span class="font-mono text-xs">{ s.Location }</span>
				} else {
					An S3 bucket: <span class="font-mono text-xs">{ s.Location }</span>
				}
			</dd>
		</dl>
		<table class="mt-4 w-full text-left text-sm">
			<thead class="text-xs uppercase tracking-wider text-muted">
				<tr><th class="py-2">Setting</th><th>Value</th><th>From</th></tr>
			</thead>
			<tbody class="divide-y divide-line">
				for _, row := range s.Settings {
					<tr>
						<td class="break-all py-2 pr-3 font-mono text-xs">{ row.Key }</td>
						<td class="break-all pr-3 font-mono text-xs">{ row.Value }</td>
						<td class="text-muted">{ sourceLabel(row.Source) }</td>
					</tr>
				}
			</tbody>
		</table>
		<p class="mt-3 text-sm text-muted">
			Settings file: <span class="break-all font-mono text-xs text-ink">{ s.EnvFile }</span>
			if !s.EnvFileExists {
				(not there yet)
			}
		</p>
		<p class="mt-3 text-sm text-muted">
			These settings can't be changed here. To move attachments to other storage, stop the server
			(<code class="font-mono text-xs text-ink">
				if brew {
					brew services stop vaquero
				} else {
					vaquero stop
				}
			</code>) and run <code class="font-mono text-xs text-ink">vaquero attachment move --to sqlite|dir|s3</code>, which saves the new settings in vaquero.env.
			<a href="/help/data-and-backups#moving-attachments-to-other-storage" class={ btnLink }>How moving works</a>
		</p>
	</section>
}

// BackupsView is the backups page: the snapshots, newest first, the
// backups directory and its volume's free space ("" when unreadable), and
// whether brew services runs the server (restore says how to stop it).
type BackupsView struct {
	Rows      []BackupRow
	Dir, Free string
	Brew      bool
}

// BackupRow is one snapshot; Schema is 0 when it can't be read.
type BackupRow struct {
	Name, Kind, Date, Size, Restore string
	Schema                          int64
}

templ BackupsPage(v BackupsView) {
	@AdminShell("Backups", "/admin/backups") {
		@titleWithHelp("Backups", "data-and-backups", "About backups")
		<p class="mt-2 max-w-xl text-sm text-muted">Snapshots of the whole database, kept in <span class="break-all font-mono text-xs text-ink">{ v.Dir }</span>. Vaquero takes one before anything that can't be undone otherwise and keeps the newest seven of each kind.</p>
		<div class="mt-6 flex flex-wrap items-center gap-3">
			<form method="post" action="/admin/backups/snapshot">
				<button type="submit" class={ btnPrimary }>Take a snapshot now</button>
			</form>
			if v.Free != "" {
				<p class="text-sm text-muted" data-backups-free>{ v.Free } free on the backups volume</p>
			}
		</div>
		<p class="mt-4 max-w-xl text-sm text-muted">
			To restore one, stop the server
			(<code class="font-mono text-xs text-ink">
				if v.Brew {
					brew services stop vaquero
				} else {
					vaquero stop
				}
			</code>), then run the command on its row. The database as it was is saved as a snapshot first.
		</p>
		if len(v.Rows) == 0 {
			<div class="mt-6">
				@emptyState("backups", "No snapshots yet.")
			</div>
		} else {
			<ul class="mt-6 max-w-3xl divide-y divide-line border-y border-line" data-backups>
				for _, b := range v.Rows {
					<li class="flex flex-col gap-2 py-3 sm:flex-row sm:items-start sm:justify-between" data-backup={ b.Name }>
						<div class="min-w-0 space-y-1">
							<p class="break-all font-mono text-xs text-ink">{ b.Name }</p>
							<p class="text-sm text-muted">
								{ b.Kind }
								if b.Date != "" {
									· { b.Date }
								}
								· { b.Size }
								if b.Schema > 0 {
									· Schema { itoa(b.Schema) }
								} else {
									· Schema unknown
								}
							</p>
							<code class="block break-all rounded bg-paper-alt px-2 py-1 font-mono text-xs text-ink">{ b.Restore }</code>
						</div>
						<form method="post" action={ templ.SafeURL("/admin/backups/" + b.Name + "/delete") } data-confirm={ "Delete " + b.Name + "? It can't be undone." } class="shrink-0">
							<button type="submit" class={ btnDanger } aria-label={ "Delete " + b.Name }>Delete</button>
						</form>
					</li>
				}
			</ul>
		}
	}
}

// TokensView is the tokens page; Created is set once, right after a token
// is made, and is the only time its value is shown.
type TokensView struct {
	Tokens  []gen.ListTokensRow
	Created string
	Name    string
	Error   string
	Now     time.Time
}

templ TokensPage(v TokensView) {
	@AdminShell("API tokens", "/admin/tokens") {
		@titleWithHelp("API tokens", "api-tokens", "About tokens")
		<p class="mt-2 max-w-xl text-sm text-muted">A token lets the CLI, a script or an agent use Vaquero's API as you. The local token is kept in the data directory for the CLI; if you revoke it, a new one is written straight away.</p>
		if v.Created != "" {
			// data-replace-url: app.js makes this POST answer's history entry
			// GET /admin/tokens, so a refresh never creates another token.
			<div class="mt-6 max-w-xl rounded-md border border-accent/40 bg-accent/10 p-4" role="status" data-replace-url="/admin/tokens">
				<label for="new-token" class="text-sm font-medium text-ink">Copy this token now. It won't be shown again.</label>
				<input id="new-token" readonly value={ v.Created } class={ inputClass + " mt-2 font-mono" }/>
			</div>
		}
		<form method="post" action="/admin/tokens" class="mt-6 flex max-w-xl items-end gap-3">
			<div class="flex-1">
				@TextInput(InputProps{Name: "name", Label: "New token name", Value: v.Name, Placeholder: "ci runner", Required: true, Error: v.Error})
			</div>
			<button type="submit" class={ btnPrimary }>Create token</button>
		</form>
		<table class="mt-8 w-full max-w-3xl text-left text-sm">
			<thead class="text-xs uppercase tracking-wider text-muted">
				<tr><th class="py-2">Name</th><th>Token</th><th>Acts as</th><th>Created</th><th>Last used</th><th></th></tr>
			</thead>
			<tbody class="divide-y divide-line">
				for _, t := range v.Tokens {
					<tr class={ templ.KV("text-muted", t.RevokedAt.Valid) }>
						<td class="py-2">{ t.Name }</td>
						<td class="font-mono text-xs">{ t.Prefix }…</td>
						<td>{ t.ActorName }</td>
						<td>{ dayOf(t.CreatedAt) }</td>
						<td>{ agoOr(t.LastUsedAt.String, v.Now, "Never") }</td>
						<td class="text-right">
							if t.RevokedAt.Valid {
								Revoked
							} else {
								<form method="post" action={ templ.SafeURL("/admin/tokens/" + t.ID + "/revoke") }>
									<button type="submit" class="text-xs text-danger hover:underline" aria-label={ "Revoke " + t.Name }>Revoke</button>
								</form>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

// MCPView is the MCP activity page: the calls shown, the agents and tools
// that appear in the log (for the filters), the filters set, and the link
// to older calls when there are more.
type MCPView struct {
	Calls       []gen.ListMCPCallsRow
	Agents      []gen.ListMCPCallActorsRow
	Tools       []string
	Agent, Tool string // Agent is an actor id
	Older       string
	Now         time.Time
}

templ MCPPage(v MCPView) {
	@AdminShell("MCP activity", "/admin/mcp") {
		@titleWithHelp("MCP activity", "mcp", "About MCP")
		<p class="mt-2 max-w-xl text-sm text-muted">Every tool call agents made over MCP, newest first. Long text in a call is cut short; calls are kept for 30 days.</p>
		<div class="mt-6 space-y-2">
			<div class="flex flex-wrap items-center gap-2" role="group" aria-label="Agent">
				<a
					href={ templ.SafeURL(mcpFilterHref("", v.Tool)) }
					class={ chipClass(v.Agent == "") }
					if v.Agent == "" {
						aria-current="true"
					}
				>All agents</a>
				for _, a := range v.Agents {
					<a
						href={ templ.SafeURL(mcpFilterHref(a.ID, v.Tool)) }
						class={ chipClass(v.Agent == a.ID) }
						if v.Agent == a.ID {
							aria-current="true"
						}
					>{ mcpActorLabel(a, v.Agents) }</a>
				}
			</div>
			<div class="flex flex-wrap items-center gap-2" role="group" aria-label="Tool">
				<a
					href={ templ.SafeURL(mcpFilterHref(v.Agent, "")) }
					class={ chipClass(v.Tool == "") }
					if v.Tool == "" {
						aria-current="true"
					}
				>All tools</a>
				for _, t := range v.Tools {
					<a
						href={ templ.SafeURL(mcpFilterHref(v.Agent, t)) }
						class={ chipClass(v.Tool == t) + " font-mono" }
						if v.Tool == t {
							aria-current="true"
						}
					>{ t }</a>
				}
			</div>
		</div>
		<div
			id="mcp-calls"
			hx-get={ mcpFilterHref(v.Agent, v.Tool) }
			hx-trigger="vq:mcp"
			data-live-mcp
			hx-select="#mcp-calls"
			hx-swap="outerHTML"
			class="mt-6"
		>
			if v.Agent != "" && !mcpAgentListed(v) {
				@emptyStateLink("no-results", "No agent with that id has made MCP calls.", mcpFilterHref("", v.Tool), "Show every agent")
			} else if len(v.Calls) == 0 && (v.Agent != "" || v.Tool != "") {
				@emptyState("no-results", "No MCP calls match.")
			} else if len(v.Calls) == 0 {
				@emptyState("agent", "No MCP calls yet.")
			} else {
				<div class="overflow-x-auto">
					<table class="w-full text-left text-sm">
						<thead class="text-xs uppercase tracking-wider text-muted">
							<tr><th class="py-2 pr-3">When</th><th class="pr-3">Agent</th><th class="pr-3">Tool</th><th class="pr-3">Arguments</th><th class="pr-3">Outcome</th><th class="text-right">Time</th></tr>
						</thead>
						<tbody class="divide-y divide-line">
							for _, c := range v.Calls {
								<tr class="align-top">
									<td class="whitespace-nowrap py-2 pr-3 text-muted" title={ utcOf(c.At) }>{ agoOr(c.At, v.Now, "") }</td>
									<td class="whitespace-nowrap py-2 pr-3">
										<span class="inline-flex items-center gap-1">
											if c.ActorKind == "agent" {
												@IconClass("agent", "h-3.5 w-3.5 shrink-0 text-accent")
											} else {
												@IconClass("person", "h-3.5 w-3.5 shrink-0 text-muted")
											}
											{ c.ActorName }
										</span>
									</td>
									<td class="py-2 pr-3 font-mono text-xs">{ c.Tool }</td>
									<td class="min-w-40 max-w-xs break-words py-2 pr-3 font-mono text-xs text-ink/80">{ c.Args }</td>
									<td class="py-2 pr-3">
										if c.Outcome == "ok" {
											<span class="inline-flex items-center gap-1 text-xs text-muted">
												@IconClass("success", "h-3.5 w-3.5 shrink-0")
												ok
											</span>
										} else {
											<span class="inline-flex items-center gap-1 text-xs text-danger">
												@IconClass("error", "h-3.5 w-3.5 shrink-0")
												{ c.Outcome }
											</span>
											if c.Message != "" {
												<span class="block text-xs text-muted">{ c.Message }</span>
											}
										}
									</td>
									<td class="whitespace-nowrap py-2 text-right text-xs text-muted">{ itoa(c.DurationMs) } ms</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
				if v.Older != "" {
					<a href={ templ.SafeURL(v.Older) } class={ btnLink + " mt-4 inline-block" }>Older</a>
				}
			}
		</div>
	}
}
