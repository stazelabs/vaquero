package templates

// ActivityPage is the newest changes across every project.
templ ActivityPage(events []EventView) {
	@Shell("Activity") {
		<h1 class={ h1Class }>Activity</h1>
		<div id="feed" hx-get="/activity" hx-trigger="vq:change" hx-select="#feed" hx-swap="outerHTML" data-live>
			if len(events) == 0 {
				@emptyState("empty", "Nothing has happened yet.")
			} else {
				<ul class="mt-6 space-y-2">
					for _, e := range events {
						<li class="flex flex-wrap items-center gap-x-2 text-sm text-ink/80">
							<span class="text-muted">
								@Icon(EventIcon(e.Kind))
							</span>
							<span class="font-medium text-ink">{ e.Actor }</span>
							if parts := EventParts(e); hasLinks(parts) {
								<span>
									@sentenceParts(parts)
								</span>
							} else if href := eventHref(e); href != "" {
								<a href={ templ.SafeURL(href) } class="wrap-anywhere hover:text-accent hover:underline">{ EventSentence(e) }</a>
							} else {
								<span>{ EventSentence(e) }</span>
							}
							<span class="text-xs text-muted">· { e.Ago }</span>
						</li>
					}
				</ul>
			}
		</div>
	}
}

// sentenceParts is an event's sentence with its linked tickets as links.
templ sentenceParts(parts []SentencePart) {
	for _, p := range parts {
		if p.Href != "" {
			<a href={ templ.SafeURL(p.Href) } class="hover:text-accent hover:underline">{ p.Text }</a>
		} else {
			{ p.Text }
		}
	}
}
