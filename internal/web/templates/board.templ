package templates

import (
	"github.com/stazelabs/vaquero/internal/board"
	"github.com/stazelabs/vaquero/internal/db/gen"
)

// Chip is one filter toggle: a link to the filter with it switched.
type Chip struct {
	Label, Href string
	On          bool
}

// BoardView is the board page.
type BoardView struct {
	Board board.Board
	Chips []Chip
	Clear string // the unfiltered board's address
}

// ListView is the list page.
type ListView struct {
	Project gen.Project
	Filter  board.Filter
	Columns []board.Column
	Chips   []Chip
	Clear   string
}

// projectHeader is the key, name and the board/list/settings/new links.
templ projectHeader(p gen.Project, view string) {
	<span hidden data-project={ p.Key }></span>
	<div class="flex flex-wrap items-center justify-between gap-4">
		<div>
			<p class="font-mono text-sm text-muted">{ p.Key }</p>
			<h1 class={ h1Class }>{ p.Name }</h1>
		</div>
		<nav aria-label="Project" class="flex items-center gap-4">
			<a
				href={ templ.SafeURL("/p/" + p.Key) }
				class={ navIconLink }
				if view == "board" {
					aria-current="page"
				}
			>
				@Icon("board")
				Board
			</a>
			<a
				href={ templ.SafeURL("/p/" + p.Key + "/list") }
				class={ navIconLink }
				if view == "list" {
					aria-current="page"
				}
			>
				@Icon("list")
				List
			</a>
			<a href={ templ.SafeURL("/p/" + p.Key + "/settings") } class={ navIconLink }>
				@Icon("settings")
				Settings
			</a>
			if !p.ArchivedAt.Valid {
				<a href={ templ.SafeURL("/p/" + p.Key + "/new") } class={ btnPrimary + " gap-1.5" }>
					@Icon("plus")
					New ticket
				</a>
			}
		</nav>
	</div>
	if p.ArchivedAt.Valid {
		<p class="mt-4 rounded-md border border-warn/40 bg-warn/10 px-3 py-2 text-sm text-ink">This project is archived. Restore it in settings to add tickets.</p>
	}
}

templ chips(cs []Chip, clear string, active bool) {
	<div class="mt-4 flex flex-wrap items-center gap-2" role="group" aria-label="Filters">
		for _, c := range cs {
			<a
				href={ templ.SafeURL(c.Href) }
				if c.On {
					aria-current="true"
				}
				class={ chipClass(c.On) }
			>{ c.Label }</a>
		}
		if active {
			<a href={ templ.SafeURL(clear) } class="text-xs text-muted hover:text-accent">Clear filters</a>
		}
	</div>
}

// BoardPage is a project's board.
templ BoardPage(v BoardView) {
	@Shell(v.Board.Project.Name) {
		@projectHeader(v.Board.Project, "board")
		<div class="flex flex-wrap items-start justify-between gap-4">
			@chips(v.Chips, v.Clear, v.Board.Filter.Active())
			<div class="mt-4">
				@helpLink("the-board", "About the board")
			</div>
		</div>
		@BoardSection(v.Board)
	}
}

// BoardSection is the board's swappable part: rails, columns and the
// milestone panel. data-filter carries the filter for drops and refreshes.
templ BoardSection(b board.Board) {
	<div
		id="board"
		data-filter={ b.Filter.Query().Encode() }
		hx-get={ FilterHref("/p/"+b.Project.Key+"/board", b.Filter) }
		hx-trigger="vq:change"
		hx-swap="outerHTML"
		data-live
		class="mt-6 flex items-start gap-3"
	>
		for _, r := range railsIn(b, "backlog") {
			@rail(b, r)
		}
		<div data-board-scroll class="flex min-w-0 flex-1 items-start gap-3 overflow-x-auto pb-2">
			for _, c := range b.Active {
				@column(b, c)
			}
		</div>
		for _, r := range railsIn(b, "cancelled") {
			@rail(b, r)
		}
		@milestonePanel(b)
	</div>
}

templ rail(b board.Board, c board.Column) {
	<details data-rail={ c.Status.ID } class="group shrink-0 rounded-md bg-paper-alt open:w-64">
		<summary class="cursor-pointer list-none px-2 py-3 text-xs font-semibold uppercase tracking-wider text-muted [writing-mode:vertical-rl] group-open:[writing-mode:horizontal-tb] hover:text-accent">
			<span class="inline-flex items-center gap-1.5">
				<span class={ categoryTint(c.Status.Category) }>
					@Icon(CategoryIcon(c.Status.Category))
				</span>
				{ c.Status.Name } · { itoa(int64(len(c.Cards))) }
			</span>
		</summary>
		<div class="px-2 pb-2">
			@cards(b, c)
		</div>
	</details>
}

templ column(b board.Board, c board.Column) {
	<section class="w-64 shrink-0 rounded-md bg-paper-alt p-2" aria-label={ c.Status.Name }>
		<h2 class="mb-2 flex justify-between px-1 text-xs font-semibold uppercase tracking-wider text-muted">
			<span class="flex items-center gap-1.5">
				<span class={ categoryTint(c.Status.Category) }>
					@Icon(CategoryIcon(c.Status.Category))
				</span>
				{ c.Status.Name }
			</span>
			<span>
				if c.Status.Category == "done" {
					this week
				} else {
					{ itoa(int64(len(c.Cards))) }
				}
			</span>
		</h2>
		@cards(b, c)
		if c.Older > 0 {
			<a href={ templ.SafeURL(olderHref(b, c)) } class="mt-1 block text-center text-xs text-muted hover:text-accent">{ itoa(int64(c.Older)) } older</a>
		}
	</section>
}

templ cards(b board.Board, c board.Column) {
	<ol data-board-column data-status={ c.Status.ID } class="min-h-12 space-y-2">
		for _, k := range c.Cards {
			@card(k)
		}
	</ol>
	if len(c.Cards) == 0 {
		<p class="px-1 text-xs text-muted">No tickets.</p>
	}
}

templ card(k board.Card) {
	<li data-card={ k.Key } data-ready?={ k.Ready } class={ cardClass(k.Ready) }>
		<a href={ templ.SafeURL("/t/" + k.Key) } class="block">
			<span class="font-mono text-[10px] text-muted">{ k.Key }</span>
			<span class="mt-0.5 block text-sm leading-snug text-ink">{ k.Title }</span>
			<span class="mt-1 flex flex-wrap items-center gap-1">
				if k.Ready {
					<span class="inline-flex items-center gap-0.5 text-[10px] font-semibold text-accent">
						@IconClass("ready", "h-3 w-3 shrink-0")
						Ready
					</span>
				}
				if k.Priority > 0 {
					<span class={ priorityClass(k.Priority) }>
						@IconClass(PriorityIcon(k.Priority), "h-3 w-3 shrink-0")
						{ PriorityLabel(k.Priority) }
					</span>
				}
				for _, t := range k.Tags {
					<span class="rounded-full bg-accent/10 px-1.5 text-[10px] text-ink/80">{ t }</span>
				}
				if k.ClaimedBy != "" {
					@claimChip(k, "ml-auto inline-flex items-center gap-0.5 rounded-full border border-accent px-1.5 text-[10px] text-accent", "h-3 w-3 shrink-0")
				}
				if showAssignee(k) {
					if k.AssigneeIsAgent {
						<span class="ml-auto inline-flex items-center gap-0.5 rounded-full border border-accent px-1.5 text-[10px] text-accent">
							@IconClass("agent", "h-3 w-3 shrink-0")
							{ k.Assignee }
						</span>
					} else {
						<span class="ml-auto inline-flex items-center gap-0.5 text-[10px] text-muted">
							@IconClass("person", "h-3 w-3 shrink-0")
							{ k.Assignee }
						</span>
					}
				}
			</span>
		</a>
	</li>
}

templ milestonePanel(b board.Board) {
	<aside class="w-48 shrink-0 space-y-4 border-l border-line pl-3 text-xs max-lg:hidden" aria-label="Milestones">
		<h2 class={ h2IconClass }>
			@Icon("milestone")
			Milestones
		</h2>
		if len(b.Milestones) == 0 {
			<p class="text-muted">No open milestones.</p>
		}
		for _, m := range b.Milestones {
			<a
				href={ templ.SafeURL(milestoneHref(b, m.ID)) }
				class="block hover:text-accent"
				if b.Filter.Milestone == m.ID {
					aria-current="true"
				}
			>
				<span class="font-medium text-ink">{ m.Name }</span>
				if m.Due != "" {
					<span class="text-muted">· { m.Due }</span>
				}
				<progress value={ itoa(m.Done) } max={ itoa(maxOne(m.Total)) } class="mt-1 block h-1.5 w-full accent-accent">{ itoa(m.Done) } of { itoa(m.Total) }</progress>
				<span class="text-muted">{ itoa(m.Done) } of { itoa(m.Total) } done</span>
			</a>
		}
		<a
			href={ templ.SafeURL(milestoneHref(b, "none")) }
			class="block text-muted hover:text-accent"
			if b.Filter.Milestone == "none" {
				aria-current="true"
			}
		>
			No milestone · { itoa(b.NoMilestone) } open
		</a>
	</aside>
}

// ListPage is every status of a project with every matching ticket.
templ ListPage(v ListView) {
	@Shell(v.Project.Name) {
		@projectHeader(v.Project, "list")
		@chips(v.Chips, v.Clear, v.Filter.Active())
		<div
			id="list"
			hx-get={ FilterHref("/p/"+v.Project.Key+"/list", v.Filter) }
			hx-trigger="vq:change"
			data-live
			hx-select="#list"
			hx-swap="outerHTML"
			class="mt-8 space-y-8"
		>
			if listEmpty(v.Columns) {
				@emptyState("no-results", "No tickets match.")
			}
			for _, c := range v.Columns {
				if len(c.Cards) > 0 {
					<section>
						<h2 class={ h2IconClass }>
							<span class={ categoryTint(c.Status.Category) }>
								@Icon(CategoryIcon(c.Status.Category))
							</span>
							{ c.Status.Name } <span class="font-normal">· { itoa(int64(len(c.Cards))) }</span>
						</h2>
						<ul class="mt-2 divide-y divide-line rounded-md border border-line">
							for _, k := range c.Cards {
								@listRow(k)
							}
						</ul>
					</section>
				}
			}
		</div>
	}
}

templ listRow(k board.Card) {
	<li data-card={ k.Key } class="flex flex-wrap items-baseline gap-x-3 gap-y-1 px-3 py-2 focus-within:ring-2 focus-within:ring-inset focus-within:ring-accent">
		<a href={ templ.SafeURL("/t/" + k.Key) } class="font-mono text-xs text-muted hover:text-accent">{ k.Key }</a>
		<a href={ templ.SafeURL("/t/" + k.Key) } class="min-w-0 flex-1 text-sm text-ink hover:text-accent">{ k.Title }</a>
		if k.Ready {
			<span class="inline-flex items-center gap-1 text-xs font-semibold text-accent">
				@IconClass("ready", "h-3.5 w-3.5 shrink-0")
				Ready
			</span>
		}
		if k.Priority > 0 {
			<span class="inline-flex items-center gap-1 text-xs text-muted">
				@IconClass(PriorityIcon(k.Priority), "h-3.5 w-3.5 shrink-0")
				{ PriorityLabel(k.Priority) }
			</span>
		}
		for _, t := range k.Tags {
			<span class="rounded-full bg-accent/10 px-2 text-xs text-ink/80">{ t }</span>
		}
		if k.ClaimedBy != "" {
			@claimChip(k, "inline-flex items-center gap-1 text-xs text-accent", "h-3.5 w-3.5 shrink-0")
		}
		if showAssignee(k) {
			<span class="inline-flex items-center gap-1 text-xs text-muted">
				if k.AssigneeIsAgent {
					@IconClass("agent", "h-3.5 w-3.5 shrink-0")
				} else {
					@IconClass("person", "h-3.5 w-3.5 shrink-0")
				}
				{ k.Assignee }
			</span>
		}
	</li>
}

// claimChip is who holds a card's claim and how long the lease has left;
// app.js rewrites the [data-claim-expires] text as "12 min left".
templ claimChip(k board.Card, class, glyph string) {
	<span class={ class } title={ "Claimed by " + k.ClaimedBy }>
		if k.ClaimantIsAgent {
			@IconClass("agent", glyph)
		} else {
			@IconClass("person", glyph)
		}
		{ k.ClaimedBy }
		@IconClass("lease", glyph)
		<span data-claim-expires={ k.ClaimExpiresAt }>{ claimUntil(k.ClaimExpiresAt) }</span>
	</span>
}
