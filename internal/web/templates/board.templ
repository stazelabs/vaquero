package templates

import (
	"github.com/stazelabs/vaquero/internal/board"
	"github.com/stazelabs/vaquero/internal/db/gen"
)

// Chip is one filter toggle: a link to the filter with it switched.
type Chip struct {
	Label, Href string
	On          bool
}

// BoardView is the board page.
type BoardView struct {
	Board board.Board
	Bar   FilterBar
}

// ListView is the list page.
type ListView struct {
	Project gen.Project
	Filter  board.Filter
	Groups  []ListGroup
	Bar     FilterBar
}

// ListGroup is one status in the list: a disclosure, open unless it is
// paged (done and cancelled), which shows Shown and offers the next page
// from Next (0 when nothing is left). Forced is a group the list is
// filtered to: always open, whatever the browser remembers.
type ListGroup struct {
	Column       board.Column
	Shown        []board.Card
	Paged        bool
	Next         int
	Open, Forced bool
}

// projectHeader is the icon, key, name and the Focus/Board/List/Settings/New
// links; the view tabs keep the filter.
templ projectHeader(p gen.Project, view string, f board.Filter) {
	<span hidden data-project={ p.Key }></span>
	<div class="flex flex-wrap items-center justify-between gap-4">
		<div data-project-header class="flex min-w-0 items-center gap-3">
			@ProjectIcon(IconOf(p), "md")
			<div class="min-w-0">
				<p class="font-mono text-sm text-muted">{ p.Key }</p>
				<h1 class={ h1Class }>{ p.Name }</h1>
			</div>
		</div>
		<nav aria-label="Project" class="flex flex-wrap items-center gap-x-4 gap-y-2">
			@viewTab(FilterHref("/p/"+p.Key, f.With("category", "")), "focus", "Focus", view == "focus")
			@viewTab(FilterHref("/p/"+p.Key+"/board", f.With("category", "")), "board", "Board", view == "board")
			@viewTab(FilterHref("/p/"+p.Key+"/list", f), "list", "List", view == "list")
			<a href={ templ.SafeURL("/p/" + p.Key + "/settings") } class={ navIconLink }>
				@Icon("settings")
				Settings
			</a>
			if !p.ArchivedAt.Valid {
				<a href={ templ.SafeURL("/p/" + p.Key + "/new") } class={ btnPrimary + " gap-1.5" }>
					@Icon("plus")
					New ticket
				</a>
			}
		</nav>
	</div>
	if p.ArchivedAt.Valid {
		<p class="mt-4 rounded-md border border-warn/40 bg-warn/10 px-3 py-2 text-sm text-ink">This project is archived. Restore it in settings to add tickets.</p>
	}
}

templ viewTab(href, icon, label string, current bool) {
	<a
		href={ templ.SafeURL(href) }
		class={ navIconLink }
		if current {
			aria-current="page"
		}
	>
		@Icon(icon)
		{ label }
	</a>
}

// BoardPage is a project's board.
templ BoardPage(v BoardView) {
	@Shell(v.Board.Project.Name) {
		@projectHeader(v.Board.Project, "board", v.Board.Filter)
		<div class="flex flex-wrap items-start justify-between gap-4">
			@filterBar(v.Bar)
			<div class="mt-4">
				@helpLink("the-board", "About the board")
			</div>
		</div>
		if v.Bar.MissingTag() != "" {
			@noTagNotice(v.Bar)
		} else {
			@BoardSection(v.Board)
		}
	}
}

// BoardSection is the board's swappable part: rails, columns and the
// milestone panel (beside the board from lg, a disclosure above it below). data-filter carries the filter for drops and refreshes.
templ BoardSection(b board.Board) {
	<div
		id="board"
		data-filter={ b.Filter.Query().Encode() }
		hx-get={ FilterHref("/p/"+b.Project.Key+"/board/fragment", b.Filter) }
		hx-trigger="vq:change"
		hx-swap="outerHTML"
		data-live
		class="mt-6"
	>
		@milestoneDisclosure(b)
		<div data-board-row class="flex items-start gap-3">
			for _, r := range railsIn(b, "backlog") {
				@rail(b, r)
			}
			<div data-board-scroll class="flex min-w-0 flex-1 items-start gap-3 overflow-x-auto pb-2">
				for _, c := range b.Active {
					@column(b, c)
				}
			</div>
			for _, r := range railsIn(b, "cancelled") {
				@rail(b, r)
			}
			@milestonePanel(b)
		</div>
	</div>
}

// rail is a backlog or cancelled status at the board's edge, a closed
// strip until opened. From md it opens in place; below md the strip stays
// and its cards overlay the columns (railPanelClass), with a close control
// and Escape to close (app.js).
templ rail(b board.Board, c board.Column) {
	<details data-rail={ c.Status.ID } class="group relative shrink-0 rounded-md bg-paper-alt md:open:w-64">
		<summary class="cursor-pointer list-none px-2 py-3 text-xs font-semibold uppercase tracking-wider text-muted [writing-mode:vertical-rl] md:group-open:[writing-mode:horizontal-tb] hover:text-accent group-open:max-md:text-accent">
			<span class="inline-flex items-center gap-1.5">
				<span class={ categoryTint(c.Status.Category) }>
					@Icon(CategoryIcon(c.Status.Category))
				</span>
				{ c.Status.Name } · { itoa(int64(len(c.Cards))) }
			</span>
		</summary>
		<div data-rail-panel={ c.Status.ID } class={ railPanelClass(c.Status.Category) }>
			<div class="mb-2 flex items-center justify-between gap-2 px-1 md:hidden">
				<span class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-muted">
					<span class={ categoryTint(c.Status.Category) }>
						@Icon(CategoryIcon(c.Status.Category))
					</span>
					{ c.Status.Name } · { itoa(int64(len(c.Cards))) }
				</span>
				<button type="button" data-rail-close aria-label={ "Close " + c.Status.Name } class="rounded-md p-1 text-muted hover:bg-paper hover:text-accent">
					@Icon("close")
				</button>
			</div>
			@cards(b, c)
		</div>
	</details>
}

templ column(b board.Board, c board.Column) {
	<section class="w-64 shrink-0 rounded-md bg-paper-alt p-2" aria-label={ c.Status.Name }>
		<h2 class="mb-2 flex justify-between px-1 text-xs font-semibold uppercase tracking-wider text-muted">
			<span class="flex items-center gap-1.5">
				<span class={ categoryTint(c.Status.Category) }>
					@Icon(CategoryIcon(c.Status.Category))
				</span>
				{ c.Status.Name }
			</span>
			<span>
				if c.Status.Category == "done" {
					this week
				} else {
					{ itoa(int64(len(c.Cards))) }
				}
			</span>
		</h2>
		@cards(b, c)
		if c.Older > 0 {
			<a href={ templ.SafeURL(olderHref(b, c)) } class="mt-1 block text-center text-xs text-muted hover:text-accent">{ itoa(int64(c.Older)) } older</a>
		}
	</section>
}

templ cards(b board.Board, c board.Column) {
	<ol data-board-column data-status={ c.Status.ID } class="min-h-12 space-y-1.5">
		for _, k := range c.Cards {
			@card(k)
		}
	</ol>
	if len(c.Cards) == 0 {
		<p class="px-1 text-xs text-muted">No tickets.</p>
	}
}

templ card(k board.Card) {
	@cardItem(k)
}

// cardItem is a board card: the key and title on one line, then, when it
// has any, one meta line (ready, priority, tier, tags, claim or agent).
// Focus and the list draw the same ticket as a row (ticketRow); both carry
// cardAttrs, so drags and j and k work the same.
templ cardItem(k board.Card) {
	<li { cardAttrs(k)... } class={ cardClass(k.Ready) }>
		<a href={ templ.SafeURL("/t/" + k.Key) } class="block min-w-0" title={ k.Title }>
			<span class="flex min-w-0 items-baseline gap-1.5">
				<span class="shrink-0 font-mono text-xs text-muted">{ k.Key }</span>
				<span class="min-w-0 flex-1 truncate text-sm text-ink">{ k.Title }</span>
			</span>
			if hasCardMeta(k) {
				<span data-card-meta class="mt-1 flex min-w-0 flex-wrap items-center gap-1 text-xs">
					if k.Ready {
						<span class="inline-flex items-center gap-0.5 font-semibold text-accent">
							@IconClass("ready", "h-3 w-3 shrink-0")
							Ready
						</span>
					}
					if k.Priority > 0 {
						<span class={ priorityClass(k.Priority) }>
							@IconClass(PriorityIcon(k.Priority), "h-3 w-3 shrink-0")
							{ PriorityLabel(k.Priority) }
						</span>
					}
					if k.Tier != "" {
						<span data-tier={ k.Tier } class="rounded-sm border border-line px-1 text-muted">{ TierLabel(k.Tier) }</span>
					}
					for _, t := range k.Tags {
						<span class="rounded-sm bg-accent/10 px-1 text-ink/80">{ t }</span>
					}
					if k.When != "" {
						<span class="text-muted">{ k.When }</span>
					}
					if k.ClaimedBy != "" {
						@claimChip(k, "ml-auto inline-flex items-center gap-0.5 rounded-sm border border-accent px-1 text-accent", "h-3 w-3 shrink-0")
					}
					if showAssignee(k) {
						if k.AssigneeIsAgent {
							<span class="ml-auto inline-flex items-center gap-0.5 rounded-sm border border-accent px-1 text-accent">
								@cardFace(k.AssigneeID, k.Assignee, "agent", "h-3 w-3 shrink-0")
								{ k.Assignee }
							</span>
						} else {
							<span class="ml-auto inline-flex items-center gap-0.5 text-muted">
								@cardFace(k.AssigneeID, k.Assignee, "person", "h-3 w-3 shrink-0")
								{ k.Assignee }
							</span>
						}
					}
				</span>
			}
		</a>
	</li>
}

// ticketRow is a ticket as one 28 px line (rowClass), for Focus's lanes
// and the list: priority mark, the number (the project's key kept for
// screen readers), the title cut with an ellipsis, then the trailing meta:
// why it waits (reason, which then stands for the claim and assignee), with full the list's ready mark, tier and tags,
// then the claim or the assignee's face, then the day it finished.
templ ticketRow(k board.Card, reason string, full bool) {
	<li { cardAttrs(k)... } class={ rowClass }>
		<a href={ templ.SafeURL("/t/" + k.Key) } class="flex h-full min-w-0 flex-1 items-center gap-2 focus:outline-none" title={ k.Title }>
			<span class={ priorityMarkClass(k.Priority) }>
				if k.Priority > 0 {
					@IconClass(PriorityIcon(k.Priority), "h-3.5 w-3.5")
					<span class="sr-only">{ PriorityLabel(k.Priority) }</span>
				}
			</span>
			<span class="w-8 shrink-0 font-mono text-xs text-muted"><span class="sr-only">{ keyPrefix(k.Key) }</span>{ keyNumber(k.Key) }</span>
			<span class={ rowTitle }>{ k.Title }</span>
			<span class={ rowMeta }>
				if reason != "" {
					<span class="truncate">{ reason }</span>
				}
				if full && k.Ready {
					<span class="inline-flex items-center gap-1 font-semibold text-accent">
						@IconClass("ready", "h-3.5 w-3.5 shrink-0")
						Ready
					</span>
				}
				if full && k.Tier != "" {
					<span data-tier={ k.Tier } class="rounded-sm border border-line px-1">{ TierLabel(k.Tier) }</span>
				}
				if full {
					for _, t := range k.Tags {
						<span class="truncate rounded-sm bg-accent/10 px-1 text-ink/80">{ t }</span>
					}
				}
				if reason == "" && k.ClaimedBy != "" {
					@claimChip(k, "inline-flex min-w-0 items-center gap-1 truncate text-accent", "h-3.5 w-3.5 shrink-0")
				}
				if reason == "" && showAssignee(k) {
					<span class="inline-flex min-w-0 items-center gap-1 truncate">
						if k.AssigneeIsAgent {
							@cardFace(k.AssigneeID, k.Assignee, "agent", "h-3.5 w-3.5 shrink-0")
						} else {
							@cardFace(k.AssigneeID, k.Assignee, "person", "h-3.5 w-3.5 shrink-0")
						}
						{ k.Assignee }
					</span>
				}
				if k.When != "" {
					<span>{ k.When }</span>
				}
			</span>
		</a>
	</li>
}

templ milestonePanel(b board.Board) {
	<aside class="w-48 shrink-0 space-y-4 border-l border-line pl-3 text-xs max-lg:hidden" aria-label="Milestones">
		<h2 class={ h2IconClass }>
			@Icon("milestone")
			Milestones
		</h2>
		@milestoneLinks(b)
	</aside>
}

// milestoneDisclosure is the milestone panel below lg: a closed
// disclosure above the board, naming the milestone the board is filtered
// to. app.js keeps it open across board refreshes.
templ milestoneDisclosure(b board.Board) {
	<details data-milestones class="group mb-3 rounded-md border border-line text-xs lg:hidden">
		<summary class="flex cursor-pointer list-none items-center gap-1.5 px-3 py-2 font-semibold uppercase tracking-wider text-muted hover:text-accent">
			@Icon("milestone")
			Milestones
			if name := milestoneFilterName(b); name != "" {
				<span class="truncate font-normal normal-case tracking-normal text-ink">· { name }</span>
			}
			<span class="ml-auto transition-transform group-open:rotate-180">
				@Icon("expand")
			</span>
		</summary>
		<div class="space-y-4 border-t border-line px-3 py-3">
			@milestoneLinks(b)
		</div>
	</details>
}

// milestoneLinks are the milestone filter links, shared by the panel and
// the disclosure.
templ milestoneLinks(b board.Board) {
	if len(b.Milestones) == 0 {
		<p class="text-muted">No open milestones.</p>
	}
	for _, m := range b.Milestones {
		<a
			href={ templ.SafeURL(milestoneHref(b, m.ID)) }
			class="block hover:text-accent"
			if b.Filter.Milestone == m.ID {
				aria-current="true"
			}
		>
			<span class="font-medium text-ink">{ m.Name }</span>
			if m.Due != "" {
				<span class="text-muted">· { m.Due }</span>
			}
			<progress value={ itoa(m.Done) } max={ itoa(maxOne(m.Total)) } class="progress-vq mt-1 block h-1.5 w-full">{ itoa(m.Done) } of { itoa(m.Total) }</progress>
			<span class="text-muted">{ itoa(m.Done) } of { itoa(m.Total) } done</span>
		</a>
	}
	<a
		href={ templ.SafeURL(milestoneHref(b, "none")) }
		class="block text-muted hover:text-accent"
		if b.Filter.Milestone == "none" {
			aria-current="true"
		}
	>
		No milestone · { itoa(b.NoMilestone) } open
	</a>
}

// ListPage is every status of a project with every matching ticket,
// each status a disclosure (app.js remembers which are open, per project).
// Done and cancelled statuses start closed and show 50 at a time.
templ ListPage(v ListView) {
	@Shell(v.Project.Name) {
		@projectHeader(v.Project, "list", v.Filter)
		@filterBar(v.Bar)
		if v.Bar.MissingTag() != "" {
			@noTagNotice(v.Bar)
		} else {
			@listSection(v)
		}
	}
}

// listSection is the list's live part.
templ listSection(v ListView) {
		<div
			id="list"
			data-list-project={ v.Project.Key }
			hx-get={ FilterHref("/p/"+v.Project.Key+"/list", v.Filter) }
			hx-trigger="vq:change"
			data-live
			hx-select="#list"
			hx-swap="outerHTML"
			hx-disinherit="*"
			class="mt-8 space-y-6"
		>
			if listEmpty(v.Groups) {
				@emptyState("no-results", "No tickets match.")
			}
			for _, g := range v.Groups {
				if len(g.Column.Cards) > 0 {
					<details
						data-list-group={ g.Column.Status.ID }
						data-paged?={ g.Paged }
						data-force-open?={ g.Forced }
						open?={ g.Open }
						class="group/list"
					>
						<summary class={ h2IconClass + " cursor-pointer list-none hover:text-accent [&::-webkit-details-marker]:hidden" }>
							<span class={ categoryTint(g.Column.Status.Category) }>
								@Icon(CategoryIcon(g.Column.Status.Category))
							</span>
							{ g.Column.Status.Name } <span class="font-normal">· { itoa(int64(len(g.Column.Cards))) }</span>
							<span class="transition-transform group-open/list:rotate-180">
								@Icon("expand")
							</span>
						</summary>
						<ul class="mt-1 border-t border-line">
							@ListRows(v.Project, v.Filter, g)
						</ul>
					</details>
				}
			}
		</div>
}

// ListRows is a list group's rows and, when more are left, its "Show 50
// more" row: the list page renders it, and so does the next page's
// request (?group=STATUS&offset=N), which replaces that row.
templ ListRows(p gen.Project, f board.Filter, g ListGroup) {
	for _, k := range g.Shown {
		@listRow(k)
	}
	if g.Next > 0 {
		<li data-list-more class="px-3 py-2 text-center">
			<button
				type="button"
				hx-get={ listPageHref(p, f, g) }
				hx-target="closest li"
				hx-swap="outerHTML"
				class="text-sm text-muted hover:text-accent"
			>Show 50 more</button>
		</li>
	}
}

templ listRow(k board.Card) {
	@ticketRow(k, "", true)
}

// claimChip is who holds a card's claim and how long the lease has left;
// app.js rewrites the [data-claim-expires] text as "12 min left".
templ claimChip(k board.Card, class, glyph string) {
	<span class={ class } title={ "Claimed by " + k.ClaimedBy }>
		if k.ClaimantIsAgent {
			@cardFace(k.ClaimantID, k.ClaimedBy, "agent", glyph)
		} else {
			@cardFace(k.ClaimantID, k.ClaimedBy, "person", glyph)
		}
		{ k.ClaimedBy }
		@IconClass("lease", glyph)
		<span data-claim-expires={ k.ClaimExpiresAt }>{ claimUntil(k.ClaimExpiresAt) }</span>
	</span>
}

// cardFace is the avatar beside a name on a card (VAQ-149), or, for a
// card without the actor's id, the glyph for its kind.
templ cardFace(id, name, glyph, class string) {
	if id != "" {
		@Avatar(ActorOf(ctx, id, name), "sm")
	} else {
		@IconClass(glyph, class)
	}
}
