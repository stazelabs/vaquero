package templates

// filterBar is the filter row above Focus, the board and the list. The
// menus are disclosures (app.js closes one on a click outside it or on
// esc, and filters the tag menu as you type in its search box); every
// choice is a link, so filters live in the address.
templ filterBar(b FilterBar) {
	<div data-filter-bar class="relative mt-4 flex flex-wrap items-center gap-2" role="group" aria-label="Filters">
		@toggleChip(b.toggle("Mine", "mine", b.Filter.Mine))
		@toggleChip(b.toggle("Agents", "agents", b.Filter.Agents))
		@filterMenu("priority", "Priority", b.priorityItems(), false)
		@filterMenu("milestone", "Milestone", b.milestoneItems(), false)
		@filterMenu("tags", "Tags", b.tagItems(), true)
		if b.Categories {
			@filterMenu("category", "Status", b.categoryItems(), false)
		}
		for _, c := range b.active() {
			<a href={ templ.SafeURL(c.Href) } aria-label={ "Remove filter " + c.Label } class={ chipClass(true) + " inline-flex items-center gap-1" }>
				{ c.Label }
				@IconClass("close", "h-3 w-3 shrink-0")
			</a>
		}
		if b.Filter.Active() {
			<a href={ templ.SafeURL(b.Base) } class="text-xs text-muted hover:text-accent">Clear filters</a>
		}
	</div>
}

// noTagNotice stands in for a page's tickets when the tag filter names no
// tag in the project.
templ noTagNotice(b FilterBar) {
	@emptyStateLink("tag", "No tag "+b.MissingTag()+" in this project.", b.clearTag(), "Clear the tag filter")
}

templ toggleChip(c Chip) {
	<a
		href={ templ.SafeURL(c.Href) }
		if c.On {
			aria-current="true"
		}
		class={ chipClass(c.On) }
	>{ c.Label }</a>
}

// filterMenu is one menu. Below md its panel spans the filter row (the
// row is its positioned parent), so it never runs off a phone's screen;
// from md it hangs under its own button.
templ filterMenu(name, label string, items []MenuItem, search bool) {
	<details data-menu={ name } class="md:relative">
		<summary class={ menuButtonClass(menuOn(items)) }>
			{ label }
			@IconClass("expand", "h-3 w-3 shrink-0")
		</summary>
		<div class="absolute left-0 z-30 mt-1 w-full rounded-md border border-line bg-paper p-1 shadow-lg md:w-56">
			if search {
				<input
					type="search"
					data-menu-search
					placeholder={ "Search " + lower(label) }
					aria-label={ "Search " + lower(label) }
					autocomplete="off"
					class="mb-1 w-full rounded border border-line bg-paper px-2 py-1 text-sm text-ink placeholder:text-muted focus:border-accent focus:outline-none"
				/>
			}
			<ul class="max-h-64 overflow-y-auto">
				for _, i := range items {
					<li data-menu-item={ i.Label }>
						<a
							href={ templ.SafeURL(i.Href) }
							if i.On {
								aria-current="true"
							}
							class={ menuItemClass(i.On) }
						>{ i.Label }</a>
					</li>
				}
			</ul>
			if search {
				if len(items) == 0 {
					<p class="px-2 py-1 text-xs text-muted">No { lower(label) } yet.</p>
				} else {
					<p data-menu-empty hidden class="px-2 py-1 text-xs text-muted">No { lower(label) } match.</p>
				}
			}
		</div>
	</details>
}
