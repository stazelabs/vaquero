package templates

import (
	"html/template"
	"strconv"

	"github.com/stazelabs/vaquero/internal/db/gen"
)

// TicketForm is the new-ticket and edit-ticket form.
type TicketForm struct {
	Project                                     gen.Project
	TicketKey                                   string // "" when creating
	Title, Body, StatusID, Priority, AssigneeID string
	Parent, MilestoneID, Tags                   string
	Tier, Model                                 string
	Version                                     string // the version the form was opened at
	Conflict                                    string // set when a save was refused as stale
	ClaimNote                                   string // someone else's claim (ClaimNote), "" for none
	Statuses, Assignees, Milestones             []Option
	Errors                                      map[string]string
}

// TicketRef is another ticket, named on this one's page.
type TicketRef struct {
	ID, Key, Title, Status string
	Done                   bool
}

// LinkGroup is one direction and kind of link: "Blocks", "Blocked by".
type LinkGroup struct {
	Label string
	Items []TicketRef // ID is the link's id, for Remove
}

// CommentRow is one comment in the thread.
type CommentRow struct {
	ID, Author, Raw, Ago string
	Body                 template.HTML
	Mine, Editing        bool
	Edited               bool
}

// AttachmentRow is one file on the ticket page.
type AttachmentRow struct {
	ID, Name, URL, Size, By, Ago string
	CanDelete                    bool
}

// PlanView is a ticket's plan on its page: the current revision rendered,
// and Diff, the lines changed since the previous revision (nil for the
// first).
type PlanView struct {
	Body     template.HTML
	Revision int64
	By, Ago  string
	Diff     []DiffLine
}

// TicketView is the ticket page.
type TicketView struct {
	Project                   gen.Project
	Ticket                    gen.Ticket
	Key                       string
	Body                      template.HTML
	Status                    gen.Status
	Assignee, Milestone       string
	AssigneeIsAgent           bool
	Parent                    *TicketRef
	Tags                      []string
	Subs                      []TicketRef
	Links                     []LinkGroup
	Comments                  []CommentRow
	Attachments               []AttachmentRow
	Plan                      *PlanView // nil when the ticket has no plan
	Events                    []EventView
	LinkKind, LinkTo, LinkErr string
	CommentBody, CommentErr   string
}

// TicketFormPage is the form for a new ticket or an edit.
templ TicketFormPage(f TicketForm) {
	@Shell(formTitle(f)) {
		<p class="font-mono text-sm text-muted"><a href={ templ.SafeURL("/p/" + f.Project.Key) } class="hover:text-accent">{ f.Project.Key }</a></p>
		<h1 class={ h1Class }>{ formTitle(f) }</h1>
		if msg := f.Errors["project"]; msg != "" {
			<p class="mt-4 text-sm text-danger" role="alert">{ msg }</p>
		}
		if f.Conflict != "" {
			<div class="mt-4 rounded-md border border-warn/40 bg-warn/10 px-3 py-2 text-sm text-ink" role="alert">
				{ f.Conflict } Saving again will overwrite those changes.
				<a href={ templ.SafeURL("/t/" + f.TicketKey) } class={ btnLink }>See the ticket now</a>
				<span class="text-muted">·</span>
				@helpLink("editing-and-conflicts", "About conflicts")
			</div>
		}
		if f.ClaimNote != "" {
			<div class="mt-4 flex flex-wrap items-center gap-x-1.5 rounded-md border border-line bg-paper-alt px-3 py-2 text-sm text-ink" data-claim-note>
				<span class="text-muted">
					@Icon("claim")
				</span>
				{ f.ClaimNote }. Claims are advisory: your save goes through, but they may be working on it.
				@helpLink("agents-and-claims", "About claims")
			</div>
		}
		<form method="post" action={ templ.SafeURL(formAction(f)) } class="mt-6 grid gap-6 lg:grid-cols-3">
			if f.Version != "" {
				<input type="hidden" name="version" value={ f.Version }/>
			}
			<div class="space-y-4 lg:col-span-2">
				@TextInput(InputProps{Name: "title", Label: "Title", Value: f.Title, Required: true, Error: f.Errors["title"]})
				@TextArea(InputProps{Name: "body", Label: "Description", Value: f.Body, Rows: 12, Placeholder: "Markdown works here.", Error: f.Errors["body"], Attrs: attachAttrs(f.TicketKey), Markdown: true})
				if f.TicketKey == "" {
					<p class="text-sm text-muted">Attach files after creating the ticket.</p>
				} else {
					<p class="text-sm text-muted">Paste or drop files into the description to attach them.</p>
				}
			</div>
			<div class="space-y-4">
				@Select(SelectProps{Name: "status", Label: "Status", Selected: f.StatusID, Options: f.Statuses, Error: f.Errors["status"]})
				@Select(SelectProps{Name: "priority", Label: "Priority", Selected: f.Priority, Options: PriorityOptions(), Error: f.Errors["priority"]})
				@Select(SelectProps{Name: "assignee", Label: "Assignee", Selected: f.AssigneeID, Options: f.Assignees, Error: f.Errors["assignee"]})
				@Select(SelectProps{Name: "milestone", Label: "Milestone", Selected: f.MilestoneID, Options: f.Milestones, Error: f.Errors["milestone"]})
				@TextInput(InputProps{Name: "parent", Label: "Parent ticket", Value: f.Parent, Placeholder: f.Project.Key + "-12", Error: f.Errors["parent"]})
				@TextInput(InputProps{Name: "tags", Label: "Tags", Value: f.Tags, Placeholder: "ui, bug", Error: f.Errors["tags"]})
				if f.Project.Workflow == 1 {
					@Select(SelectProps{Name: "tier", Label: "Tier", Selected: f.Tier, Options: TierOptions(), Error: f.Errors["tier"]})
					@TextInput(InputProps{Name: "model", Label: "Model", Value: f.Model, Placeholder: "From the tier map", Error: f.Errors["model"]})
				}
			</div>
			<div class="flex items-center gap-4 lg:col-span-3">
				<button type="submit" class={ btnPrimary }>
					if f.TicketKey == "" {
						Create ticket
					} else {
						Save ticket
					}
				</button>
				<a href={ templ.SafeURL(formCancel(f)) } class={ btnLink }>Cancel</a>
			</div>
		</form>
	}
}

// TicketPage shows one ticket: its description and fields, sub-tickets,
// links, the comment thread and its history.
templ TicketPage(v TicketView) {
	@Shell(v.Key + " " + v.Ticket.Title) {
		<span hidden data-project={ v.Project.Key }></span>
		<p class="font-mono text-sm text-muted">
			<a href={ templ.SafeURL("/p/" + v.Project.Key) } class="hover:text-accent">{ v.Project.Key }</a> / { v.Key }
		</p>
		<div class="flex flex-wrap items-start justify-between gap-4">
			<h1 class={ h1Class }>{ v.Ticket.Title }</h1>
			<a href={ templ.SafeURL("/t/" + v.Key + "/edit") } class={ btnSecondary + " gap-1.5" }>
				@Icon("edit")
				Edit ticket
			</a>
		</div>
		<div class="mt-6 grid gap-8 lg:grid-cols-3">
			<div class="space-y-10 lg:col-span-2">
				<section>
					<h2 class={ h2IconClass + " mb-2" }>
						@Icon("description")
						Description
					</h2>
					if v.Body == "" {
						<p class="text-sm text-muted">No description.</p>
					} else {
						<div class={ proseClass }>
							@templ.Raw(string(v.Body))
						</div>
					}
				</section>
				@planSection(v.Key, v.Plan)
				<section>
					<div class="flex items-center justify-between">
						<h2 class={ h2IconClass }>
							@Icon("sub-tickets")
							Sub-tickets
						</h2>
						<a href={ templ.SafeURL("/p/" + v.Project.Key + "/new?parent=" + v.Key) } class={ btnLink }>New sub-ticket</a>
					</div>
					if len(v.Subs) == 0 {
						<p class="mt-2 text-sm text-muted">No sub-tickets.</p>
					}
					<ul class="mt-2 space-y-1">
						for _, s := range v.Subs {
							<li class="text-sm">
								@refLink(s)
							</li>
						}
					</ul>
				</section>
				<section>
					<h2 class={ h2IconClass }>
						@Icon("link")
						Links
					</h2>
					for _, g := range v.Links {
						<h3 class="mt-3 text-sm font-medium text-ink">{ g.Label }</h3>
						<ul class="mt-1 space-y-1">
							for _, l := range g.Items {
								<li class="flex items-center gap-3 text-sm">
									@refLink(l)
									<form method="post" action={ templ.SafeURL("/t/" + v.Key + "/links/" + l.ID + "/delete") }>
										<button type="submit" class="text-xs text-muted hover:text-danger" aria-label={ "Remove link to " + l.Key }>Remove</button>
									</form>
								</li>
							}
						</ul>
					}
					if len(v.Links) == 0 {
						// Most tickets have no links: the form folds behind one
						// button until it's wanted (or a link was refused).
						<details data-link-add open?={ v.LinkErr != "" } class="mt-3 group">
							<summary class={ btnSecondary + " w-fit cursor-pointer list-none gap-1.5 group-open:hidden [&::-webkit-details-marker]:hidden" }>
								@Icon("plus")
								Add link
							</summary>
							@linkForm(v)
						</details>
					} else {
						@linkForm(v)
					}
				</section>
				<section id="attachments" hx-get={ "/t/" + v.Key } hx-trigger="vq:change" hx-select="#attachments" hx-swap="outerHTML" data-live>
					<h2 class={ h2IconClass }>
						@Icon("attachment")
						Attachments
					</h2>
					if len(v.Attachments) == 0 {
						<p class="mt-2 text-sm text-muted">No attachments.</p>
					}
					<ul class="mt-2 space-y-1">
						for _, a := range v.Attachments {
							<li class="flex flex-wrap items-center gap-x-3 text-sm">
								<a href={ templ.SafeURL(a.URL) } class="break-all text-accent hover:underline">{ a.Name }</a>
								<span class="text-xs text-muted">{ a.Size } · { a.By } · { a.Ago }</span>
								if a.CanDelete {
									<form method="post" action={ templ.SafeURL("/t/" + v.Key + "/attachments/" + a.ID + "/delete") }>
										<button type="submit" class="text-xs text-muted hover:text-danger" aria-label={ "Remove " + a.Name }>Remove</button>
									</form>
								}
							</li>
						}
					</ul>
					<div
						data-attach-well
						{ attachAttrs(v.Key)... }
						class="mt-3 flex flex-wrap items-center gap-3 rounded-lg border border-dashed border-line px-4 py-4 text-sm text-muted data-[over]:border-accent data-[over]:bg-accent/10"
					>
						<span>Drop files here, paste into a text box, or</span>
						<input type="file" multiple hidden data-attach-input tabindex="-1" aria-label="Files to attach"/>
						<button type="button" data-attach-choose class={ btnSecondary + " gap-1.5" }>
							@Icon("attachment")
							Choose files
						</button>
					</div>
				</section>
				<section id="comments">
					<h2 class={ h2IconClass }>
						@Icon("comment")
						Comments
					</h2>
					if len(v.Comments) == 0 {
						<p class="mt-2 text-sm text-muted">No comments yet.</p>
					}
					<ul class="mt-3 space-y-4">
						for _, c := range v.Comments {
							@commentItem(v.Key, c)
						}
					</ul>
					<form method="post" action={ templ.SafeURL("/t/" + v.Key + "/comments") } class="mt-4 space-y-3">
						@TextArea(InputProps{Name: "body", Label: "Add a comment", Value: v.CommentBody, Rows: 4, Placeholder: "Markdown works here.", Error: v.CommentErr, Attrs: attachAttrs(v.Key), Markdown: true})
						<button type="submit" class={ btnPrimary }>Add comment</button>
					</form>
				</section>
				<section>
					<h2 class={ h2IconClass }>
						@Icon("history")
						History
					</h2>
					<ul class="mt-2 space-y-1">
						for _, e := range v.Events {
							@EventLine(e)
						}
					</ul>
				</section>
			</div>
			<aside class={ panelClass + " h-fit space-y-3 text-sm" }>
				@iconField("Status", v.Status.Name, CategoryIcon(v.Status.Category), categoryTint(v.Status.Category))
				@iconField("Priority", PriorityLabel(v.Ticket.Priority), PriorityIcon(v.Ticket.Priority), "text-muted")
				if v.AssigneeIsAgent {
					@iconField("Assignee", v.Assignee, "agent", "text-accent")
				} else {
					@iconField("Assignee", orNone(v.Assignee, "Unassigned"), "person", "text-muted")
				}
				@iconField("Milestone", orNone(v.Milestone, "None"), "milestone", "text-muted")
				<div>
					<p class={ labelClass }>Parent</p>
					if v.Parent != nil {
						@refLink(*v.Parent)
					} else {
						<p class="text-muted">None</p>
					}
				</div>
				if v.Project.Workflow == 1 {
					<div data-tier>
						<p class={ labelClass }>Tier</p>
						<p class={ templ.KV("text-muted", v.Ticket.Tier == "") }>{ TierLabel(v.Ticket.Tier) }</p>
						if v.Ticket.Model != "" {
							<p class="font-mono text-xs text-muted">{ v.Ticket.Model }</p>
						}
					</div>
				}
				<div>
					<p class={ labelClass }>Tags</p>
					if len(v.Tags) == 0 {
						<p class="text-muted">None</p>
					}
					<p class="flex flex-wrap gap-1">
						for _, t := range v.Tags {
							<span class="rounded-full bg-accent/10 px-2 text-xs text-ink/80">{ t }</span>
						}
					</p>
				</div>
			</aside>
		</div>
	}
}

// planSection is the ticket's plan, read-only: the current revision and,
// folded, its changes from the one before. The live wrapper is always
// there, so a plan written elsewhere appears; empty, it is hidden and adds
// no gap.
templ planSection(key string, p *PlanView) {
	<section id="plan" hx-get={ "/t/" + key } hx-trigger="vq:change" hx-select="#plan" hx-swap="outerHTML" data-live class="empty:hidden">
		if p != nil {
			@planBody(*p)
		}
	</section>
}

templ planBody(p PlanView) {
	<h2 class={ h2IconClass + " mb-1" }>
		@Icon("plan")
		Plan
	</h2>
	<p class="mb-2 text-xs text-muted">Revision { strconv.FormatInt(p.Revision, 10) } · { p.By } · { p.Ago }</p>
	<div class={ proseClass }>
		@templ.Raw(string(p.Body))
	</div>
	if p.Diff != nil {
		<details data-plan-diff class="mt-2">
			<summary class="cursor-pointer text-xs text-muted hover:text-accent">Show changes</summary>
			<pre class="mt-1 overflow-x-auto whitespace-pre-wrap break-words rounded border border-line bg-paper-alt p-2 font-mono text-xs">
				for _, l := range p.Diff {
					<span class={ diffLineClass(l.Op) }>{ diffMark(l.Op) }<span class={ diffTextClass(l.Op) }>{ l.Text }</span></span>
				}
			</pre>
		</details>
	}
}

// linkForm adds a link from this ticket, named by its key. The ticket box
// suggests tickets as you type (GET /t/{key}/link-targets fills the
// datalist): a number, with or without the project key, or words of a title.
templ linkForm(v TicketView) {
	<form method="post" action={ templ.SafeURL("/t/" + v.Key + "/links") } class="mt-4 flex flex-wrap items-end gap-3">
		@Select(SelectProps{Name: "kind", Label: v.Key, Selected: v.LinkKind, Options: linkKindOptions()})
		<div class="flex-1">
			@TextInput(InputProps{Name: "to", Label: "Ticket", Value: v.LinkTo, Placeholder: "12, " + v.Project.Key + "-12 or words of a title", Required: true, Error: v.LinkErr, Attrs: linkTargetAttrs(v.Key)})
			<datalist id="link-targets"></datalist>
		</div>
		<button type="submit" class={ btnSecondary }>Add link</button>
	</form>
}

// LinkTargetOptions are the link box's suggestions: each ticket's key, with
// its title in the label.
templ LinkTargetOptions(opts []Option) {
	for _, o := range opts {
		<option value={ o.Value } label={ o.Label }></option>
	}
}

// iconField is a side-panel field whose value has a glyph.
templ iconField(label, value, icon, tint string) {
	<div>
		<p class={ labelClass }>{ label }</p>
		<p class="flex items-center gap-1.5 text-ink">
			<span class={ tint }>
				@Icon(icon)
			</span>
			{ value }
		</p>
	</div>
}

templ field(label, value string) {
	<div>
		<p class={ labelClass }>{ label }</p>
		<p class="text-ink">{ value }</p>
	</div>
}

templ refLink(t TicketRef) {
	<a href={ templ.SafeURL("/t/" + t.Key) } class={ "hover:text-accent", templ.KV("text-muted line-through", t.Done) }>
		<span class="font-mono text-xs text-muted">{ t.Key }</span> { t.Title }
	</a>
	if t.Status != "" {
		<span class="ml-2 text-xs text-muted">{ t.Status }</span>
	}
}

templ commentItem(key string, c CommentRow) {
	<li id={ "c-" + c.ID } class={ panelClass }>
		<p class="text-xs text-muted">
			<span class="font-medium text-ink">{ c.Author }</span> · { c.Ago }
			if c.Edited {
				· edited
			}
		</p>
		if c.Editing {
			<form method="post" action={ templ.SafeURL("/t/" + key + "/comments/" + c.ID) } class="mt-2 space-y-2">
				@TextArea(InputProps{Name: "body", ID: "c-body-" + c.ID, Label: "Edit comment", Value: c.Raw, Rows: 4, Attrs: attachAttrs(key), Markdown: true})
				<div class="flex items-center gap-4">
					<button type="submit" class={ btnPrimary }>Save comment</button>
					<a href={ templ.SafeURL("/t/" + key + "#c-" + c.ID) } class={ btnLink }>Cancel</a>
				</div>
			</form>
		} else {
			<div class={ "mt-2 " + proseClass }>
				@templ.Raw(string(c.Body))
			</div>
			if c.Mine {
				<div class="mt-2 flex items-center gap-4">
					<a href={ templ.SafeURL("/t/" + key + "?edit=" + c.ID + "#c-" + c.ID) } class="text-xs text-muted hover:text-accent">Edit</a>
					<form method="post" action={ templ.SafeURL("/t/" + key + "/comments/" + c.ID + "/delete") } data-confirm="Delete this comment?">
						<button type="submit" class="text-xs text-muted hover:text-danger">Delete</button>
					</form>
				</div>
			}
		}
	</li>
}

// EventLine is one activity line: actor, what happened, when.
templ EventLine(e EventView) {
	<li class="flex flex-wrap items-center gap-x-1.5 text-sm text-ink/80">
		<span class="text-muted">
			@Icon(EventIcon(e.Kind))
		</span>
		<span class="font-medium text-ink">{ e.Actor }</span>
		<span>
			@sentenceParts(EventParts(e))
		</span>
		<span class="text-xs text-muted">· { e.Ago }</span>
		if d := bodyChanges(e); d.Show {
			<details class="w-full pl-6">
				<summary class="cursor-pointer text-xs text-muted hover:text-accent">Show changes</summary>
				if d.TooLong {
					<p class="mt-1 text-xs text-muted">The description is too long to show.</p>
				} else {
					<pre class="mt-1 overflow-x-auto whitespace-pre-wrap break-words rounded border border-line bg-paper-alt p-2 font-mono text-xs">
						for _, l := range d.Lines {
							<span class={ diffLineClass(l.Op) }>{ diffMark(l.Op) }<span class={ diffTextClass(l.Op) }>{ l.Text }</span></span>
						}
					</pre>
				}
			</details>
		}
	</li>
}
