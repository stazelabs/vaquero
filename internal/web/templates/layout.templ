package templates

import (
	"github.com/stazelabs/vaquero/internal/version"
	"github.com/stazelabs/vaquero/internal/web/flash"
	"github.com/stazelabs/vaquero/internal/web/static"
)

// Shell is every page's frame: the document head (htmx config, icon,
// stylesheet, the two scripts with the CSP nonce), the toast, the sidebar
// (VAQ-171), then the main column: a 38 px top bar with the page's name,
// <main id="main">, and the footer.
templ Shell(title string) {
	@ShellWith(title, nil) {
		{ children... }
	}
}

// ShellWith is Shell with bar in the top bar in place of the page's name
// (a project's name, view tabs and New ticket).
templ ShellWith(title string, bar templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<meta name="htmx-config" content={ htmxConfig }/>
			<title>{ pageTitle(title) }</title>
			<link rel="icon" href={ static.URL("favicon.svg") } type="image/svg+xml"/>
			<link rel="stylesheet" href={ static.URL("css/tailwind.css") }/>
			<script src={ static.URL("vendor/htmx.min.js") } nonce={ templ.GetNonce(ctx) } defer></script>
			<script src={ static.URL("vendor/sortable.min.js") } nonce={ templ.GetNonce(ctx) } defer></script>
			<script src={ static.URL("js/app.js") } nonce={ templ.GetNonce(ctx) } defer></script>
		</head>
		<body
			class="min-h-screen bg-paper text-sm text-ink font-sans antialiased wrap-break-word"
			if seq, ok := eventSeq(ctx); ok {
				data-event-seq={ seq }
			}
		>
			if f, ok := flash.Current(ctx); ok {
				@toast(f)
			}
			<a href="#main" class="sr-only z-50 rounded-md bg-paper px-4 py-2 text-sm font-medium text-ink shadow focus:not-sr-only focus:fixed focus:left-4 focus:top-4">Skip to content</a>
			<div class="flex min-h-screen">
				@sidebar()
				<div class="flex min-w-0 flex-1 flex-col">
					@topBar(title, bar)
					<main id="main" class="w-full min-w-0 flex-1 px-4 py-6 md:px-6">
						{ children... }
					</main>
					@footer()
				</div>
			</div>
			@shortcutsDialog()
			@confirmDialog()
			// The error toast's markup, inert until app.js clones it to report
			// a failure it sees itself (an upload, a board drop).
			<template id="vq-toast-template">
				@toast(flash.Flash{Kind: flash.Error})
			</template>
		</body>
	</html>
}

// toast is the flash message: it fades after a few seconds (app.js) and its
// × closes it. Errors stay until closed.
templ toast(f flash.Flash) {
	<div
		id="vq-toast"
		role="status"
		data-sticky?={ f.Kind == flash.Error }
		class={ "fixed inset-x-4 bottom-4 z-50 mx-auto flex max-w-md items-center justify-between gap-4 rounded-md px-4 py-3 text-sm shadow-lg transition-opacity duration-500", toastClass(f.Kind) }
	>
		<span class="flex min-w-0 items-center gap-2">
			if f.Kind == flash.Error {
				@Icon("error")
			} else {
				@Icon("success")
			}
			<span class="min-w-0" data-toast-message>{ f.Message }</span>
		</span>
		<button type="button" data-toast-close aria-label="Dismiss" class="shrink-0 rounded-md p-1 opacity-80 hover:opacity-100">
			@Icon("close")
		</button>
	</div>
}

// shortcutsDialog lists the keyboard shortcuts; ? opens it (app.js).
templ shortcutsDialog() {
	<dialog id="vq-shortcuts" aria-labelledby="vq-shortcuts-title" class="m-auto w-full max-w-sm rounded-lg border border-line bg-paper p-5 text-ink backdrop:bg-scrim/40">
		<h2 id="vq-shortcuts-title" class="text-base font-semibold">Keyboard shortcuts</h2>
		<dl class="mt-4 grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm">
			for _, s := range shortcuts {
				<dt><kbd class="rounded border border-line bg-paper-alt px-1.5 font-mono text-xs">{ s[0] }</kbd></dt>
				<dd class="text-ink/80">{ s[1] }</dd>
			}
		</dl>
		<form method="dialog" class="mt-5 text-right">
			<button type="submit" class={ btnSecondary }>Close</button>
		</form>
	</dialog>
}

// confirmDialog asks before a destructive form posts: app.js opens it for
// a form carrying data-confirm="question", puts the question and the form's
// button label in it, and submits the form only on confirm. Escape and
// Cancel close it. Without JavaScript the form posts directly.
templ confirmDialog() {
	<dialog id="vq-confirm" aria-labelledby="vq-confirm-message" class="m-auto w-full max-w-sm rounded-lg border border-line bg-paper p-5 text-ink backdrop:bg-scrim/40">
		<p id="vq-confirm-message" data-confirm-message class="text-sm text-ink"></p>
		<div class="mt-5 flex justify-end gap-3">
			<button type="button" data-confirm-cancel autofocus class={ btnSecondary }>Cancel</button>
			<button type="button" data-confirm-ok class={ btnDanger }>Confirm</button>
		</div>
	</dialog>
}

// footer is every page's last line: the tagline, then copyright, the
// running version and the licence links.
templ footer() {
	<footer class="border-t border-line py-4 text-center text-xs text-muted">
		<p>Vaquero herds the chaos.</p>
		<p class="mt-1 flex flex-wrap items-baseline justify-center gap-x-1.5 gap-y-1">
			<span>© 2026 Purple Bongo, Inc.</span>
			<span aria-hidden="true">·</span>
			<a href="https://stazelabs.com" class="hover:text-ink">A Stazelabs project</a>
			<span aria-hidden="true">·</span>
			<span>Vaquero { version.Version } ({ version.Commit })</span>
			<span aria-hidden="true">·</span>
			<a href="/about/licenses" class="hover:text-ink">Licence</a>
			<span aria-hidden="true">·</span>
			<a href="/about/licenses#notices" class="hover:text-ink">Open source notices</a>
		</p>
	</footer>
}
